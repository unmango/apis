package google.protobuf

// Local stand-ins for the google.protobuf well-known types the prelude does
// not map, until tdl can import the .proto files themselves
// (UnstoppableMango/tdl#1164). instant and duration already map to Timestamp
// and Duration. The target block below maps the rest with foreign.
/// A serialized message with a URL describing its type.
type Any {
  type_url: string
  value: bytes
}

/// A structured value, a map of dynamically typed values.
type Struct {
  fields: {string -> Value}
}

/// A dynamically typed value.
enum Value {
  Null
  Number { value: decimal }
  String { value: string }
  Bool { value: bool }
  Struct { value: Struct }
  List { values: [Value] }
}

target protobuf for google.protobuf {
  Any => foreign("google/protobuf/any.proto", "google.protobuf.Any")
  Struct => foreign("google/protobuf/struct.proto", "google.protobuf.Struct")
}
