    }
    days_since_previous {
      number(53)
      option("(google.api.field_behavior)", "OUTPUT_ONLY")
    }
  }
  Vehicle {
    option("(google.api.resource)", "{ type: \"unmango.asset.vehicle/Vehicle\" pattern: \"vehicles/{vehicle}\" singular: \"vehicle\" plural: \"vehicles\" }")
    name {
      number(1)
      option("(google.api.field_behavior)", "IDENTIFIER")
    }
    uid {
      number(2)
      option("(google.api.field_behavior)", "OUTPUT_ONLY")
      option("(google.api.field_info).format", "UUID4")
    }
    display_name {
      number(3)
      option("(google.api.field_behavior)", "OPTIONAL")
    }
    labels => number(4)
