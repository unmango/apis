package unmango.asset.property.v1alpha1

import "../../../../shim/google/type.tdl" as gtype
import "../../../../shim/k8s/meta.tdl" as metav1
import "../../../../shim/scalar.tdl" as scalar
import "../../../ref/v1alpha1/ref.tdl" as ref

// Places, and the rooms inside them:
//
//   Property -> Space
//
// A Space is the unit that other domains bind to: a compute.host Host sits in
// one, an asset.vehicle Vehicle parks in one, a calendar.event Event is held
// in one. A garage is both a PropertyType, when it stands alone, and a
// SpaceType, when it is part of a house.
// ---------------------------------------------------------------------------
// Shared types
// ---------------------------------------------------------------------------
enum PropertyType { House Apartment Condo Townhouse DetachedGarage Shed StorageUnit Land Office }

enum SpaceType {
  Bedroom
  Bathroom
  Kitchen
  LivingRoom
  DiningRoom
  Office
  Garage
  Basement
  Attic
  Utility
  Closet
  Outdoor
  /// Rack, closet, or room housing compute.host Hosts.
  ServerRoom
}

/// How the property is held.
enum TenureType { OwnedOutright Mortgaged Rented Leased }

/// A measurement with its unit, kept local to this package so the domain
/// versions independently.
type Area {
  value: scalar.double
  unit: AreaUnit
}

enum AreaUnit { SquareMeter SquareFoot }

// ---------------------------------------------------------------------------
// Space
// ---------------------------------------------------------------------------
/// A room or defined area inside a Property. The unit other domains bind to.
type Space: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [metav1.OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  type: SpaceType
  area: Area
  /// Storey the space is on. Zero is ground level, negative is below it.
  floor: scalar.int32
  /// People or things that can occupy it at once. Zero means unbounded.
  capacity: scalar.int32
  /// Available for calendar.event Events to be held in.
  bookable: bool
  // Observed state.
  observed_generation: int
  conditions: [metav1.Condition]
  /// Resources from any domain currently bound here: Hosts, Vehicles, Events.
  occupant_count: scalar.int32
}

/// Desired state stamped onto Spaces generated by a Property. Field numbers
/// mirror Space 10-39.
type SpaceTemplate {
  labels: {string -> string}
  annotations: {string -> string}
  type: SpaceType
  area: Area
  floor: scalar.int32
  capacity: scalar.int32
  bookable: bool
}

// ---------------------------------------------------------------------------
// Property
// ---------------------------------------------------------------------------
/// A property, and the owner of the Spaces inside it.
type Property: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [metav1.OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  type: PropertyType
  address: gtype.PostalAddress
  location: gtype.LatLng
  tenure: TenureType
  /// Spaces to materialize. Editing this adds or removes rooms.
  spaces: [SpaceTemplate]
  /// Which Spaces this Property claims.
  selector: metav1.LabelSelector
  year_built: scalar.int32
  total_area: Area
  acquired_date: gtype.Date
  purchase_price: gtype.Money
  /// The finance.account Account holding the mortgage or paying the rent.
  finance_account: ref.ObjectReference
  /// No longer held. Retained for history.
  disposed: bool
  // Observed state.
  observed_generation: int
  conditions: [metav1.Condition]
  space_count: scalar.int32
  /// Most recent valuation, which drifts from purchase_price over time.
  estimated_value: gtype.Money
  valuation_date: gtype.Date
  /// Open asset.maintenance WorkOrders whose subject is this Property or one
  /// of its Spaces.
  open_work_order_count: scalar.int32
}

target protobuf for unmango.asset.property.v1alpha1 {
  out("gen/tdl")
  edition("2024")
  Area {
    value => number(1)
    unit => number(2)
  }
  Space {
    resource("unmango.asset.property/Space", "spaces/{space}", "space", "spaces")
    name {
      number(1)
      field_behavior(IDENTIFIER)
    }
    uid {
      number(2)
      field_behavior(OUTPUT_ONLY)
      field_info(UUID4)
    }
    display_name {
      number(3)
      field_behavior(OPTIONAL)
    }
    labels => number(4)
    annotations => number(5)
    owner_refs => number(6)
    generation {
      number(7)
      field_behavior(OUTPUT_ONLY)
    }
    create_time {
      number(8)
      field_behavior(OUTPUT_ONLY)
    }
    update_time {
      number(9)
      field_behavior(OUTPUT_ONLY)
    }
    delete_time {
      number(10)
      field_behavior(OUTPUT_ONLY)
    }
    type => number(11)
    area => number(12)
    floor => number(13)
    capacity => number(14)
    bookable => number(15)
    observed_generation {
      number(50)
      field_behavior(OUTPUT_ONLY)
    }
    conditions {
      number(51)
      field_behavior(OUTPUT_ONLY)
    }
    occupant_count {
      number(52)
      field_behavior(OUTPUT_ONLY)
    }
  }
  SpaceTemplate {
    labels => number(1)
    annotations => number(2)
    type => number(10)
    area => number(11)
    floor => number(12)
    capacity => number(13)
    bookable => number(14)
  }
  Property {
    resource("unmango.asset.property/Property", "properties/{property}", "property", "properties")
    name {
      number(1)
      field_behavior(IDENTIFIER)
    }
    uid {
      number(2)
      field_behavior(OUTPUT_ONLY)
      field_info(UUID4)
    }
    display_name {
      number(3)
      field_behavior(OPTIONAL)
    }
    labels => number(4)
    annotations => number(5)
    owner_refs => number(6)
    generation {
      number(7)
      field_behavior(OUTPUT_ONLY)
    }
    create_time {
      number(8)
      field_behavior(OUTPUT_ONLY)
    }
    update_time {
      number(9)
      field_behavior(OUTPUT_ONLY)
    }
    delete_time {
      number(10)
      field_behavior(OUTPUT_ONLY)
    }
    type => number(11)
    address => number(12)
    location => number(13)
    tenure => number(14)
    spaces => number(15)
    selector => number(16)
    year_built {
      number(17)
      field_behavior(OPTIONAL)
    }
    total_area => number(18)
    acquired_date {
      number(19)
      field_behavior(OPTIONAL)
    }
    purchase_price => number(20)
    finance_account {
      number(21)
      field_behavior(OPTIONAL)
      resource_reference("unmango.finance.account/Account")
    }
    disposed => number(22)
    observed_generation {
      number(50)
      field_behavior(OUTPUT_ONLY)
    }
    conditions {
      number(51)
      field_behavior(OUTPUT_ONLY)
    }
    space_count {
      number(52)
      field_behavior(OUTPUT_ONLY)
    }
    estimated_value {
      number(53)
      field_behavior(OUTPUT_ONLY)
    }
    valuation_date {
      number(54)
      field_behavior(OUTPUT_ONLY)
    }
    open_work_order_count {
      number(55)
      field_behavior(OUTPUT_ONLY)
    }
  }
}
