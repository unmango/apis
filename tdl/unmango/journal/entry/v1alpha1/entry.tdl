package unmango.journal.entry.v1alpha1

import "../../../../shim/google/type.tdl" as _
import "../../../ref/v1alpha1/ref.tdl" as ref

// A personal, dated log:
//
//   Entry
//
// Deliberately not Journal => Entry: unlike record.note's Notebook, there is
// one continuous stream of entries, not a set worth grouping by selector, so
// a container buys nothing. A RecurringPrompt -> Entry archetype, scheduled
// prompts that stamp out entries to answer, was considered and deferred;
// entries are freeform only for now.
//
// Mood is tracked twice, deliberately at different costs. mood and feelings
// are cheap fields set directly on every Entry. mood_measurement is an
// optional pointer to a full health.measurement Measurement for anyone who
// wants a quantified reading behind the coarse scale, a custom
// MeasurementType, a numeric anxiety score as a Component. Entry does not
// duplicate Measurement's shape, only points at it.
//
// Entry also does not carry record.note's generic Link graph. That is the
// deliberate difference between the two kinds: a Note is generic written
// material wired into the rest of the graph; an Entry is dated, personal,
// and reflective, and its only cross-domain reach is two named optional
// pointers, author and mood_measurement.
//
// The identity band departs from the repository-wide preamble a third way,
// the same variant productivity.capture CaptureItem uses: no owner_refs, no
// generation, no observed_generation, no conditions. An Entry is written
// once and later read, never declared and reconciled by a controller.
// ---------------------------------------------------------------------------
// Shared types
// ---------------------------------------------------------------------------
enum ContentFormat { Markdown PlainText Html Org Asciidoc Typst }

/// A file attached to an Entry: photo-of-the-day, a voice memo.
type Attachment {
  /// Where the bytes live. A plain string so it can address a
  /// dev.unmango.protofs path without coupling the packages.
  uri: string
  filename: string
  mime_type: string
  size_bytes: int
}

/// A coarse, non-clinical five-point scale, always cheap to set. Anyone
/// wanting a quantified or clinical reading should use mood_measurement
/// instead of trying to make this enum carry more than it should.
enum Mood { VeryLow Low Neutral Good VeryGood }

/// A closed set of access categories, the same kind of thing PlatformKind or
/// AccountType is: the category is fixed even though who a SHARED entry is
/// shared with is not modelled here. Unspecified is treated as PRIVATE by
/// convention: mental-health journaling should default closed, never open.
enum Visibility { Private Shared }

// ---------------------------------------------------------------------------
// Entry
// ---------------------------------------------------------------------------
/// One dated log entry.
type Entry: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  /// The day this entry is for, authoritative for ordering and range queries.
  /// Distinct from create_time: a backfilled entry is written today with an
  /// entry_date from last week. Not enforced unique per day, the same way
  /// record.note allows more than one note in a day.
  entry_date: Date
  title: string
  body: string
  format: ContentFormat
  mood: Mood
  /// Free-text affect tags tied to mood: "anxious", "grateful", "wired".
  /// Open-ended where mood is closed and coarse.
  feelings: [string]
  /// Human-authored topical tags: "therapy-session", "milestone". Distinct
  /// from labels, which are the machine-matched selector surface.
  tags: [string]
  /// Optional pointer at a people.contact Contact. Unset means single-user.
  /// A plain reference, not a ~> attachment: nothing admits or rejects it.
  author: ref.ObjectReference
  /// Optional pointer at a health.measurement Measurement for a quantified
  /// mood or anxiety reading behind the coarse mood scale.
  mood_measurement: ref.ObjectReference
  attachments: [Attachment]
  visibility: Visibility
  // Observed state.
  word_count: int32
  last_edited_time: instant
}

target protobuf for unmango.journal.entry.v1alpha1 {
  out("../../../../../proto")
  file("entry.proto")
  import("google/api/field_behavior.proto")
  import("google/api/field_info.proto")
  import("google/api/resource.proto")
  Date => foreign("google/type/date.proto", "google.type.Date")
  edition("2024")
  Attachment {
    uri => number(1)
    filename => number(2)
    mime_type => number(3)
    size_bytes => number(4)
  }
  Entry {
    option("(google.api.resource)", "{ type: \"unmango.journal.entry/Entry\" pattern: \"entries/{entry}\" singular: \"entry\" plural: \"entries\" }")
    // tdl-gap: one reserved directive per block, so both proto reserved ranges are merged.
    // 6, 7: owner_refs, generation: nothing owns or reconciles an entry
    // 50, 51: observed_generation, conditions: nothing reconciles an entry
    reserved(6, 7, 50, 51)
    name {
      number(1)
      option("(google.api.field_behavior)", "IDENTIFIER")
    }
    uid {
      number(2)
      option("(google.api.field_behavior)", "OUTPUT_ONLY")
      option("(google.api.field_info).format", "UUID4")
    }
    display_name {
      number(3)
      option("(google.api.field_behavior)", "OPTIONAL")
    }
    labels => number(4)
    annotations => number(5)
    create_time {
      number(8)
      option("(google.api.field_behavior)", "OUTPUT_ONLY")
    }
    update_time {
      number(9)
      option("(google.api.field_behavior)", "OUTPUT_ONLY")
    }
    delete_time {
      number(10)
      option("(google.api.field_behavior)", "OUTPUT_ONLY")
    }
    entry_date => number(11)
    title {
      number(12)
      option("(google.api.field_behavior)", "OPTIONAL")
    }
    body => number(13)
    format => number(14)
    mood => number(15)
    feelings => number(16)
    tags => number(17)
    author {
      number(18)
      option("(google.api.field_behavior)", "OPTIONAL")
      option("(google.api.resource_reference).type", "\"unmango.people.contact/Contact\"")
    }
    mood_measurement {
      number(19)
      option("(google.api.field_behavior)", "OPTIONAL")
      option("(google.api.resource_reference).type", "\"unmango.health.measurement/Measurement\"")
    }
    attachments => number(20)
    visibility => number(21)
    word_count {
      number(52)
      option("(google.api.field_behavior)", "OUTPUT_ONLY")
    }
    last_edited_time {
      number(53)
      option("(google.api.field_behavior)", "OUTPUT_ONLY")
    }
  }
}
