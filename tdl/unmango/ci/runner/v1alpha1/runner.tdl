package unmango.ci.runner.v1alpha1

import "../../../../shim/k8s/meta.tdl" as _
import "../../../ref/v1alpha1/ref.tdl" as ref
import "../../../uom/v1alpha1/uom.tdl" as uom

// CI runner fleet management, modelled directly on Deployment -> ReplicaSet
// -> Pod:
//
//   RunnerPool -> RunnerSet -> Runner @ compute.host Host
//
// A RunnerPool owns a RunnerSet per template revision and shifts replicas
// between them to roll out a change. Each RunnerSet holds one immutable
// template revision and keeps that many Runners alive. Each Runner is bound to
// a Host exactly as a Pod is bound to a Node.
//
// Field numbers follow the repository-wide bands:
//   1-9    identity
//   10-39  templated desired state, mirrored by *Template at the same numbers
//   40-49  assigned desired state, set by a scheduler rather than a template
//   50+    observed state
// ---------------------------------------------------------------------------
// Shared types
// ---------------------------------------------------------------------------
/// Where the runner offers itself for work.
type RunnerScope {
  /// Organization, user, or group that owns the repositories.
  owner: string
  /// Single repository to serve. Unset means the whole owner scope.
  repository: string
}

/// How a RunnerPool replaces Runners when its template changes.
type RolloutStrategy {
  type: RolloutStrategyType
  /// Extra Runners permitted above the desired replica count during a rollout.
  /// ROLLING_UPDATE only.
  max_surge: int32
  /// Runners permitted to be unavailable during a rollout. ROLLING_UPDATE only.
  max_unavailable: int32
}

enum RolloutStrategyType {
  /// Drain every existing Runner before creating replacements.
  Recreate
  /// Shift replicas between RunnerSets incrementally.
  RollingUpdate
}

// ---------------------------------------------------------------------------
// Runner
// ---------------------------------------------------------------------------
/// A single runner process registered with a CI platform, bound to one Host.
/// The Pod of this chain.
type Runner: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Templated desired state. RunnerTemplate mirrors 10-39.
  /// The compute.platform Platform this runner registers with.
  platform: ref.ObjectReference
  scope: RunnerScope
  capabilities: [string]
  version: string
  /// Exit after completing a single job. The standard posture for untrusted
  /// workloads, since it guarantees a clean environment per job.
  ephemeral: bool
  max_concurrency: int32
  resources: uom.ResourceQuantity
  /// Restricts which Hosts this Runner may be bound to.
  host_selector: LabelSelector
  // Assigned desired state.
  /// The Host this Runner is bound to. Unset means unscheduled.
  host: ref.ObjectReference
  // Observed state.
  observed_generation: int
  phase: RunnerPhase
  conditions: [Condition]
  /// The job currently executing, when phase is BUSY.
  current_job: ref.ObjectReference
  bind_time: instant
  last_heartbeat_time: instant
  completed_job_count: int
}

enum RunnerPhase {
  /// Accepted but not yet bound to a Host.
  Pending
  /// Registered and waiting for work.
  Idle
  /// Executing a job.
  Busy
  /// Finishing current work, accepting no more. The state an ephemeral Runner
  /// passes through before termination.
  Draining
  /// Registered but not reachable.
  Offline
}

/// Desired state stamped onto Runners generated by a RunnerSet. Field numbers
/// mirror Runner 10-39 exactly; the assigned band is absent because bindings
/// are scheduled, not templated.
type RunnerTemplate {
  /// Merged into the labels of generated Runners. Must match the owning
  /// RunnerSet selector.
  labels: {string -> string}
  annotations: {string -> string}
  /// The compute.platform Platform this runner registers with.
  platform: ref.ObjectReference
  scope: RunnerScope
  capabilities: [string]
  version: string
  ephemeral: bool
  max_concurrency: int32
  resources: uom.ResourceQuantity
  /// Restricts which Hosts a generated Runner may be bound to.
  host_selector: LabelSelector
}

// ---------------------------------------------------------------------------
// RunnerSet
// ---------------------------------------------------------------------------
/// Keeps a fixed number of Runners alive from one immutable template revision.
/// The ReplicaSet of this chain. Normally owned by a RunnerPool rather than
/// created directly.
type RunnerSet: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  replicas: int32
  /// Which Runners this set claims. Must match template.labels.
  selector: LabelSelector
  /// Stamped onto every generated Runner. Immutable once set; a RunnerPool
  /// creates a new RunnerSet rather than mutating this.
  template: RunnerTemplate
  /// Identifies the template revision, so a RunnerPool can tell its RunnerSets
  /// apart and roll back to one.
  revision: string
  // Observed state.
  observed_generation: int
  /// Runners currently claimed by this set.
  observed_replicas: int32
  ready_replicas: int32
  /// Ready and idle, so available to accept a job.
  available_replicas: int32
  conditions: [Condition]
}

// ---------------------------------------------------------------------------
// RunnerPool
// ---------------------------------------------------------------------------
/// Declarative fleet of runners. Owns one RunnerSet per template revision and
/// shifts replicas between them to roll a change out. The Deployment of this
/// chain, and the kind a human normally edits.
type RunnerPool: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  replicas: int32
  /// Which RunnerSets this pool claims.
  selector: LabelSelector
  /// Editing this creates a new RunnerSet revision and starts a rollout.
  template: RunnerTemplate
  strategy: RolloutStrategy
  /// Superseded RunnerSets kept for rollback. Zero keeps none.
  revision_history_limit: int32
  /// Lower and upper replica bounds when an autoscaler drives this pool. Unset
  /// min disables autoscaling.
  min_replicas: int32
  max_replicas: int32
  // Observed state.
  observed_generation: int
  observed_replicas: int32
  /// Replicas running the newest template revision.
  updated_replicas: int32
  ready_replicas: int32
  available_replicas: int32
  /// Replicas owned by superseded RunnerSets, still draining.
  outdated_replicas: int32
  /// Revision of the RunnerSet currently serving most traffic.
  current_revision: string
  /// Revision being rolled out. Equal to current_revision when settled.
  update_revision: string
  conditions: [Condition]
}

