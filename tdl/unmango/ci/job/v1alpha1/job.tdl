package unmango.ci.job.v1alpha1

import "../../../../shim/k8s/meta.tdl" as metav1
import "../../../../shim/scalar.tdl" as scalar
import "../../../ref/v1alpha1/ref.tdl" as ref

// CI work definitions and their executions:
//
//   Pipeline -> JobRun @ ci.runner Runner
//
// A Pipeline is the durable definition; a JobRun is one execution of it,
// owned by the Pipeline that produced it. A JobRun with no runner set is
// pending, exactly as an unscheduled Pod has no node.
//
// Steps are embedded rather than being their own kind. They have no
// independent lifetime, are never addressed on their own, and always die with
// their JobRun.
// ---------------------------------------------------------------------------
// Shared types
// ---------------------------------------------------------------------------
/// Lifecycle of a JobRun or one of its steps.
enum JobPhase {
  /// Accepted, waiting for a Runner to bind to.
  Queued
  Running
  Succeeded
  Failed
  /// Stopped by a human or by a superseding run.
  Cancelled
  /// Conditions for running were not met.
  Skipped
}

/// What caused a JobRun to be created.
type Trigger {
  kind: TriggerKind
  /// Branch, tag, or other ref that was pushed.
  ref: string
  commit_sha: string
  /// Who or what initiated it.
  actor: TriggerActor
}

// tdl-gap: oneof becomes a separate message
enum TriggerActor {
  /// A people.contact Contact for a human.
  Contact { contact: ref.ObjectReference }
  /// A schedule name or other non-resource actor.
  SystemActor { system_actor: string }
}

enum TriggerKind {
  Push
  PullRequest
  Tag
  Schedule
  Manual
  /// Started by another JobRun completing.
  Upstream
}

/// One unit of work inside a JobRun.
type Step {
  name: string
  /// Shell command or action reference, depending on the platform.
  command: string
  // Observed. Meaningful only once the parent JobRun starts.
  phase: JobPhase
  start_time: instant
  completion_time: instant
  exit_code: scalar.int32
}

// ---------------------------------------------------------------------------
// JobRun
// ---------------------------------------------------------------------------
/// One execution of a Pipeline.
type JobRun: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [metav1.OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Templated desired state. JobTemplate mirrors 10-39.
  steps: [Step]
  parameters: {string -> string}
  /// Restricts which Runners may pick this up.
  runner_selector: metav1.LabelSelector
  timeout: duration
  max_retries: scalar.int32
  /// JobRuns that must succeed before this one may bind.
  depends_on: [ref.ObjectReference]
  // Assigned desired state.
  /// The Runner executing this. Unset means queued.
  runner: ref.ObjectReference
  // Observed state.
  observed_generation: int
  phase: JobPhase
  conditions: [metav1.Condition]
  trigger: Trigger
  queue_time: instant
  bind_time: instant
  start_time: instant
  completion_time: instant
  exit_code: scalar.int32
  attempt: scalar.int32
  /// Where logs can be fetched. A plain string so it can address a
  /// dev.unmango.protofs path without coupling the packages.
  logs_uri: string
}

/// Desired state stamped onto JobRuns generated by a Pipeline. Field numbers
/// mirror JobRun 10-39; the assigned band is absent because the Runner binding
/// is scheduled, not templated.
type JobTemplate {
  labels: {string -> string}
  annotations: {string -> string}
  steps: [Step]
  parameters: {string -> string}
  /// Restricts which Runners may pick up a generated JobRun.
  runner_selector: metav1.LabelSelector
  timeout: duration
  max_retries: scalar.int32
  depends_on: [ref.ObjectReference]
}

// ---------------------------------------------------------------------------
// Pipeline
// ---------------------------------------------------------------------------
/// Durable definition of a job, and the owner of every JobRun it produces.
type Pipeline: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [metav1.OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  /// Stamped onto every generated JobRun.
  template: JobTemplate
  /// Which trigger kinds produce a JobRun.
  triggers: [TriggerKind]
  /// Cron expression, when TRIGGER_KIND_SCHEDULE is enabled.
  schedule: string
  /// The vcs.repository Repository this pipeline belongs to.
  repository: ref.ObjectReference
  /// Stop producing new JobRuns without deleting the definition.
  suspended: bool
  /// Completed JobRuns to retain. Zero retains all.
  run_history_limit: scalar.int32
  /// Cancel an in-flight JobRun when a newer one is triggered for the same ref.
  cancel_superseded: bool
  // Observed state.
  observed_generation: int
  conditions: [metav1.Condition]
  active_run_count: scalar.int32
  total_run_count: int
  succeeded_run_count: int
  failed_run_count: int
  last_run: ref.ObjectReference
  last_run_phase: JobPhase
  last_run_time: instant
  next_schedule_time: instant
}

