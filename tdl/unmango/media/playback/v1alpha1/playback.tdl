package unmango.media.playback.v1alpha1

import "../../../../shim/google/type.tdl" as _
import "../../../../shim/k8s/meta.tdl" as _
import "../../../ref/v1alpha1/ref.tdl" as ref

// What has been watched, read, or listened to, and by whom:
//
//   PlayState ~> media.title Title
//   PlayState -> PlaySession
//
// A PlayState attaches to a Title rather than being owned by it. That matters:
// progress is per person, several people watch the same show at different
// points, and deleting a title should not silently erase the record of having
// seen it. The Title admits the attachment and reports it as a Condition.
//
// A PlaySession is one sitting, owned by the PlayState it advanced. Keeping
// sessions separate is what lets a resume point be a single number while the
// history behind it stays complete.
// ---------------------------------------------------------------------------
// Shared types
// ---------------------------------------------------------------------------
enum PlaybackPhase {
  /// Attached but never started.
  Unplayed
  InProgress
  Completed
  /// Started and deliberately given up on. Distinct from in progress, which
  /// implies intent to return.
  Abandoned
}

enum SessionOutcome {
  /// Ran to the end of the title.
  Finished
  /// Stopped partway, intending to resume.
  Paused
  Stopped
  /// Ended by an error rather than a choice.
  Interrupted
}

// ---------------------------------------------------------------------------
// PlaySession
// ---------------------------------------------------------------------------
/// One sitting. Append-only history behind a PlayState.
type PlaySession: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state. Recorded facts, since a session is written as it happens.
  when: Interval
  /// Offset into the title at the start and end of the sitting.
  start_position: duration
  end_position: duration
  /// Time actually spent playing, excluding pauses and seeks.
  watched_duration: duration
  outcome: SessionOutcome
  /// Where it was played.
  played_on: PlaySessionPlayedOn
  /// The media.library LibraryItem the bytes came from, when played locally.
  library_item: ref.ObjectReference
  /// Playback speed. 1.0 is normal; audiobooks and podcasts often are not.
  speed: float64
  // Observed state.
  observed_generation: int
  conditions: [Condition]
  /// end_position minus start_position. Differs from watched_duration when the
  /// sitting involved seeking.
  progress_delta: duration
  /// Fraction of the title's runtime covered by this sitting.
  fraction_of_title: float64
}

// tdl-gap: oneof becomes a separate message
enum PlaySessionPlayedOn {
  /// A compute.host Host.
  Device { device: ref.ObjectReference }
  /// A device outside this API, identified only by name.
  ExternalDeviceName { external_device_name: string }
}

// ---------------------------------------------------------------------------
// PlayState
// ---------------------------------------------------------------------------
/// One person's progress through one Title. Attached to the Title, owner of the
/// sessions that produced it.
type PlayState: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  /// The media.title Title being played. Attachment rather than ownership:
  /// progress is per person and outlives the catalog entry.
  parent_ref: ref.ParentReference
  /// The people.contact Contact whose progress this is.
  viewer: ref.ObjectReference
  /// Where to resume. The one number a player needs.
  position: duration
  /// Personal rating, 0 to 100.
  rating: int32
  /// Marked to watch next, independently of any Collection.
  queued: bool
  /// Hide from continue-watching without discarding the record.
  hidden: bool
  /// Which PlaySessions this state claims.
  selector: LabelSelector
  notes: string
  // Observed state.
  observed_generation: int
  phase: PlaybackPhase
  /// Reports whether the Title admitted the attachment.
  conditions: [Condition]
  /// Position over the title's runtime, 0.0 to 1.0.
  progress: float64
  /// Times played to completion. Above one means rewatched.
  play_count: int32
  session_count: int32
  /// Summed over sessions, so a rewatched title reports more than its runtime.
  total_watched_duration: duration
  first_played_time: instant
  last_played_time: instant
  completed_time: instant
  /// Position has not advanced in a long time while phase is IN_PROGRESS.
  stalled: bool
}

