package unmango.media.library.v1alpha1

import "../../../../shim/google/type.tdl" as gtype
import "../../../../shim/k8s/meta.tdl" as metav1
import "../../../../shim/scalar.tdl" as scalar
import "../../../ref/v1alpha1/ref.tdl" as ref

// What is actually held, and how it is grouped:
//
//   Library    => LibraryItem @ media.title Edition
//   Collection => media.title Title
//
// Both Library and Collection claim members by label selector rather than
// naming them, which is the Service -> Pods relationship. Adding a label to an
// item joins it to a library; no edit to the library is needed. This is what
// makes an automatic collection and a hand-curated one the same kind, differing
// only in how precise the selector is.
//
// A LibraryItem binds to an Edition the way a Runner binds to a Host: the
// binding is made rather than declared, and an item with no edition is an
// unmatched file waiting to be identified.
// ---------------------------------------------------------------------------
// Shared types
// ---------------------------------------------------------------------------
enum OwnershipType {
  OwnedPhysical
  OwnedDigital
  Rented
  /// Available through an active subscription rather than held.
  Subscribed
  Borrowed
  LentOut
  Wishlist
}

enum ItemPhase {
  /// Present but not yet bound to an Edition.
  Unmatched
  /// Bound and playable.
  Available
  /// Files are missing or unreadable.
  Missing
  /// Physically present but out on loan.
  Lent
}

/// One file backing a LibraryItem. Several make up a multi-disc release or a
/// set of alternate encodings.
type MediaFile {
  /// Where the bytes live. A plain string so it can address a
  /// dev.unmango.protofs path, a local path, or a remote URL without coupling
  /// the packages.
  uri: string
  size_bytes: int
  /// "mkv", "flac", "epub", "iso".
  container: string
  video: VideoTrack
  audio: [AudioTrack]
  subtitles: [SubtitleTrack]
  /// Content hash, for detecting corruption or duplication.
  checksum: string
  /// Part number within a multi-file release, one-based.
  part: scalar.int32
}

type VideoTrack {
  codec: string  // "h264", "hevc", "av1"
  width: scalar.int32
  height: scalar.int32
  frame_rate: scalar.double
  bitrate_bps: int
  /// "sdr", "hdr10", "dolby-vision".
  dynamic_range: string
}

type AudioTrack {
  codec: string  // "aac", "flac", "truehd"
  channels: scalar.int32
  sample_rate_hz: scalar.int32
  bitrate_bps: int
  /// ISO 639 code.
  language_code: string
  /// Commentary, described audio, or another non-primary track.
  secondary: bool
}

type SubtitleTrack {
  codec: string  // "subrip", "pgs", "ass"
  /// ISO 639 code.
  language_code: string
  /// Covers only foreign dialogue rather than all speech.
  forced: bool
  hearing_impaired: bool
}

// ---------------------------------------------------------------------------
// LibraryItem
// ---------------------------------------------------------------------------
/// One held copy of something. Binds to the Edition it is a copy of.
type LibraryItem: Entity {
  name: string
  uid: uuid
  display_name: string
  /// Also the surface Library and Collection selectors match against.
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [metav1.OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  ownership: OwnershipType
  /// The files backing this copy. Empty for something owned physically or held
  /// only through a subscription.
  files: [MediaFile]
  /// Where a physical copy sits: an asset.property Space, with the shelf
  /// within it, if any, as the ParentReference section.
  location: ref.ParentReference
  /// Where a digital copy came from: a service name, a rip, a purchase.
  source: string
  acquired_date: gtype.Date
  purchase_price: gtype.Money
  /// When a rental or loan is due back.
  due_date: gtype.Date
  /// The people.contact Contact currently holding it, when lent out.
  lent_to: ref.ObjectReference
  notes: string
  // Assigned desired state.
  /// The media.title Edition this is a copy of. Unset means unmatched.
  edition: ref.ObjectReference
  /// The media.title Title, denormalized from the Edition so a Collection can
  /// select on it without a join.
  title: ref.ObjectReference
  // Observed state.
  observed_generation: int
  phase: ItemPhase
  conditions: [metav1.Condition]
  /// Libraries whose selectors currently claim this item. Makes the selector
  /// edge navigable from the item side.
  claimed_by: [ref.ObjectReference]
  file_count: scalar.int32
  total_size_bytes: int
  /// Best video height across the files, so quality is sortable.
  max_height: scalar.int32
  last_verified_time: instant
  /// A file recorded in files could not be read at last verification.
  has_missing_files: bool
}

// ---------------------------------------------------------------------------
// Library
// ---------------------------------------------------------------------------
/// A managed set of LibraryItems, claimed by selector. The thing a scanner
/// populates and a player browses.
type Library: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [metav1.OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  /// Which LibraryItems belong. An empty selector claims nothing, never
  /// everything.
  selector: metav1.LabelSelector
  /// Roots a scanner walks to discover items. Plain strings so they can address
  /// dev.unmango.protofs paths.
  scan_uris: [string]
  /// Labels stamped onto items discovered by a scan, which is how a scanner
  /// makes them match this library's selector.
  item_labels: {string -> string}
  /// Seconds between scans. Zero disables scanning.
  scan_interval_seconds: scalar.int32
  /// Re-check that recorded files still exist during a scan.
  verify_files: bool
  // Observed state.
  observed_generation: int
  conditions: [metav1.Condition]
  item_count: scalar.int32
  unmatched_item_count: scalar.int32
  missing_item_count: scalar.int32
  total_size_bytes: int
  last_scan_time: instant
  next_scan_time: instant
  scanning: bool
}

// ---------------------------------------------------------------------------
// Collection
// ---------------------------------------------------------------------------
/// A curated grouping of Titles, claimed by selector. A hand-picked list and an
/// automatic one are the same kind: the difference is only how specific the
/// selector is.
type Collection: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [metav1.OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  /// Which media.title Titles belong.
  selector: metav1.LabelSelector
  summary: string
  /// Members in a deliberate order, for a collection whose sequence matters.
  /// Anything the selector claims but this omits sorts after these.
  ordered_members: [ref.ObjectReference]
  /// Artwork. A plain string so it can address a dev.unmango.protofs path.
  poster_uri: string
  /// Restrict membership to Titles with a held LibraryItem.
  owned_only: bool
  // Observed state.
  observed_generation: int
  conditions: [metav1.Condition]
  member_count: scalar.int32
  owned_member_count: scalar.int32
  /// Rolled up from media.playback across members.
  watched_fraction: scalar.double
}

