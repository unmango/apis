      option("(google.api.field_behavior)", "OPTIONAL")
    }
    region {
      number(18)
      option("(google.api.field_behavior)", "OPTIONAL")
    }
    external_ids => number(19)
    preferred => number(20)
    observed_generation {
      number(50)
      option("(google.api.field_behavior)", "OUTPUT_ONLY")
    }
    conditions {
      number(51)
      option("(google.api.field_behavior)", "OUTPUT_ONLY")
    }
    owned_copy_count {
      number(52)
      option("(google.api.field_behavior)", "OUTPUT_ONLY")
    }
  }
  Title {
    option("(google.api.resource)", "{ type: \"unmango.media.title/Title\" pattern: \"titles/{title}\" singular: \"title\" plural: \"titles\" }")
    name {
      number(1)
      option("(google.api.field_behavior)", "IDENTIFIER")
    }
    uid {
      number(2)
      option("(google.api.field_behavior)", "OUTPUT_ONLY")
      option("(google.api.field_info).format", "UUID4")
    }
    display_name {
      number(3)
      option("(google.api.field_behavior)", "OPTIONAL")
    }
    labels => number(4)
    annotations => number(5)
    owner_refs => number(6)
    generation {
      number(7)
      option("(google.api.field_behavior)", "OUTPUT_ONLY")
    }
    create_time {
      number(8)
      option("(google.api.field_behavior)", "OUTPUT_ONLY")
    }
    update_time {
      number(9)
      option("(google.api.field_behavior)", "OUTPUT_ONLY")
    }
    delete_time {
      number(10)
      option("(google.api.field_behavior)", "OUTPUT_ONLY")
    }
    kind {
      number(11)
      option("(google.api.field_behavior)", "IMMUTABLE")
    }
    title => number(12)
