package unmango.media.title.v1alpha1

import "../../../../shim/google/type.tdl" as _
import "../../../../shim/k8s/meta.tdl" as _
import "../../../ref/v1alpha1/ref.tdl" as ref

// The catalog: works, and the concrete releases of them.
//
//   Title -> Title (Series -> Season -> Episode) -> Edition
//
// Title nests through owner references rather than dedicated series and season
// fields, which keeps a nine-season television show, a two-disc album, and a
// standalone film the same shape. The MediaKind says which level a title sits
// at; the ownership edge says what it belongs to.
//
// An Edition is a specific release of a Title: a theatrical cut, a remaster, a
// particular pressing. Bytes on disk belong to media.library, not here, so the
// catalog stays meaningful for things not owned.
// ---------------------------------------------------------------------------
// Shared types
// ---------------------------------------------------------------------------
enum MediaKind {
  Movie
  Series
  Season
  Episode
  Album
  Track
  Book
  Audiobook
  Game
  Podcast
  PodcastEpisode
  Short
}

/// Identifier in an external catalog, so records can be reconciled against
/// imdb, tmdb, musicbrainz, isbn, igdb, and the rest.
type ExternalId {
  source: string
  value: string
}

/// Someone who worked on a title.
type Credit {
  /// A people.contact Contact when the person is known personally,
  /// otherwise unset and identified by name alone.
  contact: ref.ObjectReference
  person_name: string
  /// "director", "author", "artist", "developer", "narrator".
  role: string
  /// Ordering within the role. Lower is billed first.
  billing_order: int32
  /// Part played, for a performing credit.
  character: string
}

enum ReleaseFormat {
  Theatrical
  BluRay
  Dvd
  Digital
  Vinyl
  Cd
  Cassette
  Hardcover
  Paperback
  Ebook
  Cartridge
  Streaming
}

// ---------------------------------------------------------------------------
// Edition
// ---------------------------------------------------------------------------
/// A specific release of a Title. What a media.library LibraryItem binds to.
type Edition: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  format: ReleaseFormat
  /// What distinguishes this release: "Director's Cut", "2011 Remaster",
  /// "Deluxe Edition".
  edition_name: string
  release_date: Date
  /// Runtime or length specific to this cut, which may differ from the Title's.
  runtime: duration
  /// ISO 639 codes.
  languages: [string]
  subtitle_languages: [string]
  publisher: string
  /// ISO 3166 code of the release territory.
  region: string
  external_ids: [ExternalId]
  /// The release the catalog treats as canonical for its Title.
  preferred: bool
  // Observed state.
  observed_generation: int
  conditions: [Condition]
  /// media.library LibraryItems holding a copy of this edition.
  owned_copy_count: int32
}

// ---------------------------------------------------------------------------
// Title
// ---------------------------------------------------------------------------
/// A work. Nests to form series and seasons, and owns its Editions.
type Title: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  /// The parent Title for a season or episode. Absent at the top of a work.
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  /// Immutable once set; create a new Title rather than changing what level
  /// of the hierarchy an existing one occupies. An update must reject a
  /// change to this field.
  kind: MediaKind
  /// Title as presented.
  title: string
  /// Title normalized for ordering, with leading articles dropped.
  sort_title: string
  /// Title in the language of origin, when it differs.
  original_title: string
  summary: string
  release_date: Date
  genres: [string]
  runtime: duration
  credits: [Credit]
  external_ids: [ExternalId]
  /// Position within the parent. Season number on a season, track or episode
  /// number on a leaf.
  sequence_number: int32
  /// Content rating in its issuing system: "PG-13", "TV-MA", "E10+".
  content_rating: string
  /// ISO 639 code of the original language.
  original_language: string
  /// Which child Titles and Editions this Title claims.
  selector: LabelSelector
  /// Artwork. Plain strings so they can address dev.unmango.protofs paths
  /// without coupling the packages.
  poster_uri: string
  backdrop_uri: string
  /// Personal rating, 0 to 100. Distinct from any external score.
  rating: int32
  // Observed state.
  observed_generation: int
  conditions: [Condition]
  /// Direct children: seasons under a series, episodes under a season.
  child_count: int32
  /// Leaf titles anywhere beneath this one.
  descendant_leaf_count: int32
  edition_count: int32
  /// At least one Edition has a media.library LibraryItem.
  owned: bool
  /// Summed over descendants, for a series or album.
  total_runtime: duration
  /// Rolled up from media.playback. Present here so a series can report
  /// progress without the catalog depending on playback.
  watched_fraction: float64
}

target protobuf for unmango.media.title.v1alpha1 {
  out("../../../../../proto")
  file("title.proto")
  import("google/api/field_behavior.proto")
  import("google/api/field_info.proto")
  import("google/api/resource.proto")
  Date => foreign("google/type/date.proto", "google.type.Date")
  Condition => foreign("k8s.io/apimachinery/pkg/apis/meta/v1/generated.proto", "k8s.io.apimachinery.pkg.apis.meta.v1.Condition")
  LabelSelector => foreign("k8s.io/apimachinery/pkg/apis/meta/v1/generated.proto", "k8s.io.apimachinery.pkg.apis.meta.v1.LabelSelector")
  OwnerReference => foreign("k8s.io/apimachinery/pkg/apis/meta/v1/generated.proto", "k8s.io.apimachinery.pkg.apis.meta.v1.OwnerReference")
  edition("2024")
  ExternalId {
    source => number(1)
    value => number(2)
  }
  Credit {
    contact {
      number(1)
      option("(google.api.field_behavior)", "OPTIONAL")
