    edition_name {
      number(12)
      option("(google.api.field_behavior)", "OPTIONAL")
    }
    release_date {
      number(13)
      option("(google.api.field_behavior)", "OPTIONAL")
    }
    runtime => number(14)
    languages => number(15)
    subtitle_languages => number(16)
    publisher {
