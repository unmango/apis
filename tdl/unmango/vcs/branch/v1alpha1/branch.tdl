      number(16)
      field_behavior(OPTIONAL)
    }
    delete_on_merge => number(17)
    observed_generation {
      number(50)
      field_behavior(OUTPUT_ONLY)
    }
    phase {
      number(51)
      field_behavior(OUTPUT_ONLY)
    }
    conditions {
      number(52)
      field_behavior(OUTPUT_ONLY)
    }
    head_revision {
      number(53)
