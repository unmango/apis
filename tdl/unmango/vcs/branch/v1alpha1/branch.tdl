      number(60)
      field_behavior(OUTPUT_ONLY)
    }
    stale {
      number(61)
      field_behavior(OUTPUT_ONLY)
    }
  }
  Tag {
    resource("unmango.vcs.branch/Tag", "tags/{tag}", "tag", "tags")
    name {
      number(1)
      field_behavior(IDENTIFIER)
    }
    uid {
      number(2)
      field_behavior(OUTPUT_ONLY)
      field_info(UUID4)
    }
    display_name {
      number(3)
      field_behavior(OPTIONAL)
    }
    labels => number(4)
    annotations => number(5)
    owner_refs => number(6)
    generation {
      number(7)
      field_behavior(OUTPUT_ONLY)
    }
    create_time {
      number(8)
      field_behavior(OUTPUT_ONLY)
    }
    update_time {
      number(9)
      field_behavior(OUTPUT_ONLY)
    }
    delete_time {
      number(10)
      field_behavior(OUTPUT_ONLY)
    }
    ref_name => number(11)
    target_revision {
      number(12)
      field_behavior(IMMUTABLE)
    }
    type => number(13)
    message {
      number(14)
      field_behavior(OPTIONAL)
