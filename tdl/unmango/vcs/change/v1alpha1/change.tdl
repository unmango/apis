package unmango.vcs.change.v1alpha1

import "../../../../shim/k8s/meta.tdl" as _
import "../../../ref/v1alpha1/ref.tdl" as ref

// Proposed changes and their review:
//
//   ChangeSet -> Change ~> vcs.branch Branch
//                  ^~ Review ~> people.contact Contact
//   Change @ ci.job JobRun
//
// A Change is one proposal to move a branch: a pull request, a merge request,
// a Gerrit change. The name is forge-neutral on purpose, since the same shape
// serves all three.
//
// A Change attaches to its target Branch rather than being owned by it, and
// the Branch admits or rejects it on its Protection rules. That is the
// Gateway -> HTTPRoute relationship in its most literal form here: required
// approvals and required checks are the branch's terms, evaluated against a
// change the branch did not author.
//
// A ChangeSet materializes one Change per target repository from a template.
// That is what a stacked or fleet-wide change is: an edit applied across many
// repositories, tracked as one thing, where each Change carries an owner
// reference back and the set reports how far the rollout has progressed.
// ---------------------------------------------------------------------------
// Shared types
// ---------------------------------------------------------------------------
enum ChangePhase {
  /// Authored but not yet offered for review.
  Draft
  Open
  /// Enough approvals, checks green, waiting to merge.
  Approved
  /// A reviewer asked for work before this can proceed.
  ChangesRequested
  /// Cannot merge: conflicts, failing checks, or an unmet branch rule.
  Blocked
  Merged
  Closed
}

enum MergeStrategy {
  MergeCommit
  Squash
  Rebase
  /// Refuse anything that is not already a fast-forward.
  FastForwardOnly
}

enum ReviewVerdict {
  /// Read, with remarks, but no position taken.
  Comment
  Approve
  RequestChanges
}

/// How a ChangeSet sequences the Changes it materializes.
enum RolloutOrder {
  /// Open every Change at once.
  Parallel
  /// Open the next only once the previous has merged.
  Sequential
  /// Each Change targets the branch of the one before it, so the set forms a
  /// dependent stack rather than independent proposals.
  Stacked
}

/// A remark anchored to a location in the diff. Embedded rather than a kind:
/// it has no lifetime apart from its Review and is never addressed alone.
type ReviewComment {
  path: string
  /// Line in the post-image. Zero means the comment is on the file as a whole.
  line: int32
  body: string
  resolved: bool
  /// Concrete replacement the author can apply directly.
  suggestion: string
}

// ---------------------------------------------------------------------------
// Review
// ---------------------------------------------------------------------------
/// One reviewer's position on one Change. Attached to the Change and admitted
/// by it, so a reviewer can record a verdict without write access to the
/// proposal itself.
type Review: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  /// The Change being reviewed. The Change decides whether to admit this.
  parent_ref: ref.ParentReference
  /// The people.contact Contact reviewing.
  reviewer: ref.ObjectReference
  verdict: ReviewVerdict
  body: string
  comments: [ReviewComment]
  /// The head commit this verdict was formed against. What
  /// Protection.dismiss_stale_approvals compares to decide staleness.
  reviewed_revision: string
  /// The reviewer was asked rather than volunteering.
  requested: bool
  // Observed state.
  observed_generation: int
  /// Reports whether the Change admitted this review, and why not when it did
  /// not.
  conditions: [Condition]
  submitted_time: instant
  comment_count: int32
  unresolved_comment_count: int32
  /// The Change moved past reviewed_revision, so this verdict no longer
  /// counts toward the target branch's required approvals.
  stale: bool
}

// ---------------------------------------------------------------------------
// Change
// ---------------------------------------------------------------------------
/// One proposal to move a branch. A pull request, a merge request, a change.
type Change: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  /// The ChangeSet that materialized this, when it came from one. A change
  /// opened by hand has no owner.
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Templated desired state. ChangeTemplate mirrors 10-39.
  title: string
  body: string
  draft: bool
  merge_strategy: MergeStrategy
  /// people.contact Contacts whose review is requested.
  reviewers: [ref.ObjectReference]
  /// people.contact Contact expected to carry the change forward.
  assignee: ref.ObjectReference
  /// Merge as soon as the target branch's rules are satisfied.
  auto_merge: bool
  delete_source_on_merge: bool
  /// Which Reviews this Change claims.
  selector: LabelSelector
  // Assigned desired state. Computed per repository when materialized.
  /// The vcs.branch Branch this change targets. Attachment: the branch admits
  /// or rejects on its Protection rules, and was authored independently.
  target_ref: ref.ParentReference
  /// The vcs.branch Branch holding the proposed commits.
  source_branch: ref.ObjectReference
  /// The vcs.repository Repository both branches live in.
  repository: ref.ObjectReference
  /// Forge-assigned number. Zero before the change exists on the forge.
  number: int32
  /// people.contact Contact who opened it.
  author: ref.ObjectReference
  // Observed state.
  observed_generation: int
  phase: ChangePhase
  /// Reports admission by the target branch, mergeability, and check status.
  conditions: [Condition]
  review_count: int32
  approval_count: int32
  rejection_count: int32
  unresolved_comment_count: int32
  /// Approvals still required by the target branch's Protection.
  approvals_outstanding: int32
  /// ci.job JobRuns triggered by this change.
  check_runs: [ref.ObjectReference]
  checks_passed: bool
  /// No conflicts against the target branch.
  mergeable: bool
  merge_blocked_reason: string
  head_revision: string
  commit_count: int32
  files_changed: int32
  additions: int32
  deletions: int32
  opened_time: instant
  merged_time: instant
  closed_time: instant
  merge_commit_revision: string
}

/// Desired state stamped onto Changes generated by a ChangeSet. Field numbers
/// mirror Change 10-39; the assigned band is absent because branches,
/// repository, and forge number are resolved per target.
type ChangeTemplate {
  labels: {string -> string}
  annotations: {string -> string}
  /// Ref name to create in each target repository for the source branch.
  source_ref_name: string
  title: string
  body: string
  draft: bool
  merge_strategy: MergeStrategy
  reviewers: [ref.ObjectReference]
  assignee: ref.ObjectReference
  auto_merge: bool
  delete_source_on_merge: bool
  /// Which Reviews a generated Change claims.
  selector: LabelSelector
}

// ---------------------------------------------------------------------------
// ChangeSet
// ---------------------------------------------------------------------------
/// One edit applied across many repositories, tracked as a single thing. Owns
/// every Change it materializes, so abandoning the set closes all of them.
type ChangeSet: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  /// Stamped onto each materialized Change.
  template: ChangeTemplate
  /// vcs.repository Repositories to open a Change in. Named explicitly.
  repositories: [ref.ObjectReference]
  /// Or claimed by selector, via a vcs.repository RepositoryGroup. Applied in
  /// addition to repositories above.
  repository_group: ref.ObjectReference
  /// Which Changes this set claims.
  selector: LabelSelector
  order: RolloutOrder
  /// Changes permitted open at once. Zero means unbounded. Ignored when order
  /// is SEQUENTIAL.
  max_concurrent: int32
  /// Stop opening new Changes without closing the ones already out.
  suspended: bool
  /// Close every open Change if any merged one is reverted.
  rollback_on_revert: bool
  /// Merged Changes to retain. Zero retains all.
  change_history_limit: int32
  // Observed state.
  observed_generation: int
  phase: ChangeSetPhase
  conditions: [Condition]
  /// Target repositories resolved from repositories and repository_group.
  target_count: int32
  change_count: int32
  open_count: int32
  approved_count: int32
  merged_count: int32
  closed_count: int32
  blocked_count: int32
  /// Merged over target_count, 0.0 to 1.0.
  merged_fraction: float64
  /// The Change at the front of the queue, for SEQUENTIAL and STACKED.
  next_change: ref.ObjectReference
  first_opened_time: instant
  completed_time: instant
  /// Latest revision of the template. Changes record the revision they were
  /// created with.
  revision: string
}

enum ChangeSetPhase {
  /// Declared, nothing opened yet.
  Pending
  /// Materializing and merging.
  RollingOut
  /// Every target merged.
  Completed
  /// Stalled on a blocked Change, for SEQUENTIAL and STACKED.
  Stalled
  /// Given up on, with outstanding Changes closed.
  Abandoned
}

