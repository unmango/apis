package unmango.finance.budget.v1alpha1

import "../../../../shim/google/type.tdl" as _
import "../../../../shim/k8s/meta.tdl" as _
import "../../../ref/v1alpha1/ref.tdl" as ref

// Envelope budgeting, structured as the three-level expansion chain this
// repository borrows from Kubernetes:
//
//   Budget -> BudgetPeriod -> Allocation => finance.transaction Transaction
//   Budget -> BudgetRevision >> BudgetRevision
//
// A Budget is the standing intent, edited by a human. It materializes one
// BudgetPeriod per calendar period, and each BudgetPeriod materializes the
// Allocations for that period. This is Deployment -> ReplicaSet -> Pod: the
// top level holds the template, the middle level pins one revision of it to a
// window of time, and the bottom level is the thing that actually does work.
//
// An Allocation claims Transactions by label selector rather than owning them,
// so a transaction can be recategorized by relabelling it, and the same
// transaction is never duplicated across periods.
//
// A BudgetRevision is a content-addressed snapshot of a Budget's template,
// recorded whenever it changes. It follows the same immutable-node band
// convention as vcs.commit Commit and codegen.artifact Artifact, since
// nothing about a past revision is ever declared or reconciled: 1-9
// content-addressed identity, 10-39 content fixed at creation, 50+ derived.
// ---------------------------------------------------------------------------
// Allocation
// ---------------------------------------------------------------------------
/// One category envelope for one period. The leaf of the chain.
type Allocation: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Templated desired state. AllocationTemplate mirrors 10-39.
  /// Spending category this envelope covers: "groceries", "fuel".
  category: string
  /// Amount budgeted for the period.
  limit: Money
  /// Which Transactions this envelope claims. Selection rather than ownership,
  /// so a Transaction is claimed by label and can move between envelopes
  /// without being rewritten. Matches against finance.transaction
  /// Transaction.labels: the two fields are a cross-package contract neither
  /// file imports the other to enforce, so a Transaction whose labelling
  /// convention changes can silently stop matching an Allocation that expects
  /// the old one.
  selector: LabelSelector
  /// Carry an unspent remainder into the next period's matching Allocation.
  rollover: bool
  /// Treat overspend as an error condition rather than a note.
  strict: bool
  /// Ordering hint for display. Lower sorts first.
  priority: int32
  /// Save toward this total rather than (or alongside) capping spend at
  /// limit. Unset means this envelope is spend-down only.
  target_amount: Money
  /// Reach target_amount by this date. Unset means no deadline.
  target_date: Date
  // Observed state.
  observed_generation: int
  conditions: [Condition]
  /// Summed over claimed Transactions.
  spent: Money
  /// Limit plus rolled_over minus spent. Negative means overspent.
  remaining: Money
  /// Amount carried in from the previous period.
  rolled_over: Money
  matched_transaction_count: int32
  /// Spent divided by the effective limit. Above 1.0 means overspent.
  utilization: float64
  /// Spent divided by target_amount. Only meaningful when target_amount is
  /// set.
  percent_funded: float64
  /// Extrapolated from the recent contribution rate. Unset when there isn't
  /// enough history to project from.
  projected_completion_date: Date
  /// The Allocation whose surplus absorbed this one's overspend. Set by
  /// whoever reconciles the graph when strict is false and remaining went
  /// negative.
  covered_by: ref.ObjectReference
}

/// Desired state stamped onto Allocations generated by a BudgetPeriod. Field
/// numbers mirror Allocation 10-39.
type AllocationTemplate {
  labels: {string -> string}
  annotations: {string -> string}
  category: string
  limit: Money
  /// Which Transactions a generated Allocation claims.
  selector: LabelSelector
  rollover: bool
  strict: bool
  priority: int32
  target_amount: Money
  target_date: Date
}

// ---------------------------------------------------------------------------
// BudgetPeriod
// ---------------------------------------------------------------------------
/// One calendar window of a Budget, owning the Allocations for that window.
/// The ReplicaSet of this chain: it pins one revision of the Budget's template
/// so that editing the Budget never rewrites history.
type BudgetPeriod: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Templated desired state. BudgetPeriodTemplate mirrors 10-39.
  /// Envelopes to materialize for this window.
  allocations: [AllocationTemplate]
  /// Ceiling across all envelopes. Independent of the sum of their limits, so
  /// an overallocated period is detectable.
  total_limit: Money
  /// Transactions that fall in this window, matched before any child
  /// Allocation's own selector runs. Normally a date-range label written by
  /// the ingest path.
  selector: LabelSelector
  // Assigned desired state. Set when the period is materialized, not
  // templated, since the window is what distinguishes one period from another.
  start_date: Date
  /// Inclusive.
  end_date: Date
  /// Identifies which revision of the Budget template produced this period.
  /// Equal to the digest of the corresponding finance.budget BudgetRevision.
  revision: string
  // Observed state.
  observed_generation: int
  conditions: [Condition]
  allocation_count: int32
  /// Summed over child Allocations.
  total_allocated: Money
  total_spent: Money
  total_remaining: Money
  /// Child Allocations whose spent exceeds their effective limit.
  overspent_allocation_count: int32
  /// True once end_date has passed and no further Transactions are expected.
  closed: bool
  /// Transactions this period's selector claims into its window that no
  /// child Allocation has claimed.
  unclaimed_transaction_count: int32
}

/// Desired state stamped onto BudgetPeriods generated by a Budget. Field
/// numbers mirror BudgetPeriod 10-39; the assigned band is absent because the
/// date window is computed per period rather than templated.
type BudgetPeriodTemplate {
  labels: {string -> string}
  annotations: {string -> string}
  allocations: [AllocationTemplate]
  total_limit: Money
  /// Transactions that fall in a generated period's window.
  selector: LabelSelector
}

// ---------------------------------------------------------------------------
// Budget
// ---------------------------------------------------------------------------
/// Standing budget intent. The kind a human edits, and the owner of every
/// BudgetPeriod it materializes.
type Budget: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  /// How often a new BudgetPeriod is materialized.
  period: CalendarPeriod
  /// First period starts on or after this date.
  start_date: Date
  /// Stop materializing after this date. Unset means indefinitely.
  end_date: Date
  /// Stamped onto each materialized BudgetPeriod. Editing this affects future
  /// periods only; existing ones keep the revision they were created with.
  template: BudgetPeriodTemplate
  /// Materialize periods up to this date. Bounds how far ahead the chain runs,
  /// rather than generating an unbounded future.
  materialize_through: Date
  /// ISO 4217. Every Money under this budget uses it.
  currency_code: string
  /// Which BudgetPeriods this Budget claims.
  selector: LabelSelector
  /// Stop materializing new periods without deleting the budget.
  suspended: bool
  /// Superseded periods to retain. Zero retains all.
  period_history_limit: int32
  // Observed state.
  observed_generation: int
  conditions: [Condition]
  period_count: int32
  /// The period containing today.
  current_period: ref.ObjectReference
  /// Rolled up from the current period.
  current_allocated: Money
  current_spent: Money
  current_remaining: Money
  /// Latest revision of the template. Equal to the digest of the
  /// corresponding finance.budget BudgetRevision.
  revision: string
  materialized_through: Date
}

// ---------------------------------------------------------------------------
// BudgetRevision
// ---------------------------------------------------------------------------
/// A content-addressed snapshot of a Budget's template, recorded whenever it
/// changes. Nothing here is declared or reconciled, so the identity band
/// reserves what it has no use for the way vcs.commit Commit and
/// codegen.artifact Artifact do: no display_name, no owner_refs, no
/// generation, no update_time, no delete_time. Those numbers stay reserved
/// rather than being reused, so a field number means the same thing here as
/// everywhere else. Editing a Budget's template produces a new BudgetRevision
/// rather than changing this one.
type BudgetRevision: Entity {
  // Content-addressed identity.
  /// Hash over the content band and the budget reference.
  digest: string
  uid: uuid
  labels: {string -> string}
  annotations: {string -> string}
  create_time: instant
  /// The Budget this snapshots. Scope rather than ownership, matching
  /// vcs.commit Commit's repository field.
  budget: ref.ObjectReference
  // Content, fixed at creation and covered by the digest.
  /// Previous revision's digest. Empty for the first revision. This is the
  /// >> edge.
  parent_digest: string
  /// Snapshot of Budget.template at the moment this revision was recorded.
  template: BudgetPeriodTemplate
  /// Free-text note describing why the standing intent changed.
  note: string
  // Derived, computed by whoever indexes the graph.
  conditions: [Condition]
  /// Position in the chain. The first revision is 1.
  sequence_number: int32
}

