    period => number(13)
    interval => number(14)
    start_date => number(15)
    end_date {
      number(16)
      field_behavior(OPTIONAL)
    }
    materialize_through => number(17)
    selector => number(18)
    suspended => number(19)
    match_window_days => number(20)
    observed_generation {
