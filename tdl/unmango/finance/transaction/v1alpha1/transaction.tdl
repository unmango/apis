      field_behavior(OPTIONAL)
    }
    description {
      number(13)
      field_behavior(OPTIONAL)
    }
    splits => number(14)
    note {
      number(15)
      field_behavior(OPTIONAL)
    }
  }
  RecurringTransaction {
    resource("unmango.finance.transaction/RecurringTransaction", "recurringTransactions/{recurring_transaction}", "recurringTransaction", "recurringTransactions")
    name {
      number(1)
      field_behavior(IDENTIFIER)
    }
    uid {
      number(2)
      field_behavior(OUTPUT_ONLY)
      field_info(UUID4)
    }
    display_name {
      number(3)
      field_behavior(OPTIONAL)
    }
    labels => number(4)
    annotations => number(5)
    owner_refs => number(6)
    generation {
      number(7)
      field_behavior(OUTPUT_ONLY)
    }
    create_time {
      number(8)
      field_behavior(OUTPUT_ONLY)
    }
    update_time {
      number(9)
      field_behavior(OUTPUT_ONLY)
    }
    delete_time {
      number(10)
