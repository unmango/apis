    }
    external_id {
      number(43)
      field_behavior(OUTPUT_ONLY)
    }
    observed_generation {
      number(50)
      field_behavior(OUTPUT_ONLY)
    }
    state {
      number(51)
      field_behavior(OUTPUT_ONLY)
    }
    conditions {
      number(52)
      field_behavior(OUTPUT_ONLY)
    }
    booked_time {
      number(53)
      field_behavior(OUTPUT_ONLY)
    }
    claimed_by {
      number(54)
      field_behavior(OUTPUT_ONLY)
      resource_reference("unmango.finance.budget/Allocation")
    }
    running_balance {
      number(55)
      field_behavior(OUTPUT_ONLY)
    }
    matched_projection {
      number(56)
      field_behavior(OUTPUT_ONLY)
      resource_reference("unmango.finance.transaction/Transaction")
    }
  }
  TransactionTemplate {
    labels => number(1)
    annotations => number(2)
    amount => number(10)
    direction => number(11)
    merchant {
