package unmango.finance.transaction.v1alpha1

import "../../../../shim/google/type.tdl" as gtype
import "../../../../shim/k8s/meta.tdl" as metav1
import "../../../../shim/scalar.tdl" as scalar
import "../../../ref/v1alpha1/ref.tdl" as ref

// Money moving, and the standing arrangements that move it:
//
//   RecurringTransaction -> Transaction ~> finance.account Account
//                           Transaction => claimed by finance.budget Allocation
//
// A Transaction attaches to an Account rather than being owned by it: the
// transaction is a fact that survives the account being closed, and deleting
// an account should not silently erase spending history.
//
// A RecurringTransaction does own the Transactions it predicts, so
// subscriptions and bills materialize forward on the same expansion pattern
// the rest of the repository uses. Once a predicted Transaction is matched
// against a real one, it stops being a prediction.
// ---------------------------------------------------------------------------
// Shared types
// ---------------------------------------------------------------------------
enum TransactionState {
  /// Predicted by a RecurringTransaction, not yet seen at the institution.
  Projected
  /// Authorized but not settled. Amount may still change.
  Pending
  Posted
  /// Cancelled before settling.
  Void
  /// Settled, then undone by a later entry.
  Reversed
}

enum TransactionDirection {
  Debit
  Credit
  /// One leg of a movement between two owned Accounts. Excluded from spending
  /// totals, since no money left the household.
  Transfer
}

/// Part of a Transaction assigned to one budget envelope. Splits let a single
/// purchase land in several categories without being torn into several
/// transactions.
type Split {
  /// The finance.budget Allocation this part counts against.
  allocation: ref.ObjectReference
  /// Category label, kept alongside the reference so a split stays meaningful
  /// when no budget exists.
  category: string
  amount: gtype.Money
  note: string
}

// ---------------------------------------------------------------------------
// Transaction
// ---------------------------------------------------------------------------
/// A single movement of money.
type Transaction: Entity {
  name: string
  uid: uuid
  display_name: string
  /// Also the surface a finance.budget Allocation.selector matches against:
  /// the two fields are a cross-package contract neither file imports the
  /// other to enforce, so relabelling transactions can silently stop them
  /// matching an Allocation that expects the old convention.
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [metav1.OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Templated desired state. TransactionTemplate mirrors 10-39.
  amount: gtype.Money
  direction: TransactionDirection
  merchant: string
  description: string
  /// How the amount is distributed across budget envelopes. A single split
  /// covering the full amount is the common case.
  splits: [Split]
  note: string
  // Assigned desired state.
  /// The Account this transaction belongs to. Attachment rather than
  /// ownership: the fact outlives the account.
  account: ref.ObjectReference
  /// Date the institution assigned. What budget periods bucket on.
  posted_date: gtype.Date
  /// The matching leg, when direction is TRANSFER.
  transfer_peer: ref.ObjectReference
  /// Identifier at the institution, used to deduplicate on re-sync.
  external_id: string
  // Observed state.
  observed_generation: int
  state: TransactionState
  conditions: [metav1.Condition]
  booked_time: instant
  /// Allocations whose selectors currently claim this transaction. Makes the
  /// selector edge navigable from the transaction side.
  claimed_by: [ref.ObjectReference]
  /// Account balance immediately after this transaction settled.
  running_balance: gtype.Money
  /// The projected Transaction this one was matched against, if any.
  matched_projection: ref.ObjectReference
}

/// Desired state stamped onto Transactions generated by a RecurringTransaction.
/// Field numbers mirror Transaction 10-39; the assigned band is absent because
/// the account and date are computed per occurrence.
type TransactionTemplate {
  labels: {string -> string}
  annotations: {string -> string}
  amount: gtype.Money
  direction: TransactionDirection
  merchant: string
  description: string
  splits: [Split]
  note: string
}

// ---------------------------------------------------------------------------
// RecurringTransaction
// ---------------------------------------------------------------------------
/// A standing arrangement that produces Transactions: a subscription, a salary,
/// a mortgage payment. Owns the projected Transactions it materializes.
type RecurringTransaction: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [metav1.OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  /// Stamped onto each projected Transaction.
  template: TransactionTemplate
  /// Account the projected transactions attach to.
  account: ref.ObjectReference
  /// How often it recurs.
  period: gtype.CalendarPeriod
  /// Number of periods between occurrences. Two with period MONTH means
  /// every other month.
  interval: scalar.int32
  start_date: gtype.Date
  /// Unset means indefinitely.
  end_date: gtype.Date
  /// Project occurrences up to this date, bounding how far the chain runs.
  materialize_through: gtype.Date
  /// Which projected Transactions this arrangement claims.
  selector: metav1.LabelSelector
  /// Stop projecting without deleting the arrangement. What a paused
  /// subscription looks like.
  suspended: bool
  /// Tolerance in days when matching a real transaction to a projection.
  match_window_days: scalar.int32
  // Observed state.
  observed_generation: int
  conditions: [metav1.Condition]
  projected_count: scalar.int32
  matched_count: int
  next_occurrence_date: gtype.Date
  last_matched_date: gtype.Date
  materialized_through: gtype.Date
  /// Mean of matched amounts, which drifts from the templated amount as prices
  /// change.
  observed_amount: gtype.Money
}

target protobuf for unmango.finance.transaction.v1alpha1 {
  out("gen/tdl")
  edition("2024")
  Split {
    allocation {
      number(1)
      field_behavior(OPTIONAL)
      resource_reference("unmango.finance.budget/Allocation")
    }
    category => number(2)
    amount => number(3)
    note {
      number(4)
      field_behavior(OPTIONAL)
    }
  }
  Transaction {
    resource("unmango.finance.transaction/Transaction", "transactions/{transaction}", "transaction", "transactions")
    name {
      number(1)
      field_behavior(IDENTIFIER)
    }
    uid {
      number(2)
      field_behavior(OUTPUT_ONLY)
      field_info(UUID4)
    }
    display_name {
      number(3)
      field_behavior(OPTIONAL)
