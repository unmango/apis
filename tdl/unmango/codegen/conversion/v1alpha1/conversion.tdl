package unmango.codegen.conversion.v1alpha1

import "../../../../shim/k8s/meta.tdl" as _
import "../../../ref/v1alpha1/ref.tdl" as ref

// Standing instructions to convert something, and their executions:
//
//   Conversion -> ConversionRun @ ci.job JobRun
//
// A Conversion is the durable definition: this converter, over these inputs,
// with these options, producing output here. A ConversionRun is one
// execution of it, owned by the Conversion that produced it.
//
// A ConversionRun binds to a ci.job JobRun rather than to a ci.runner Runner
// directly. ci already models a unit of work, its execution, and its
// placement on capacity, and duplicating that here would fork it. The
// binding chain runs ConversionRun -> JobRun -> Runner -> Host, and this
// domain only owns the first hop. It is the same delegation vcs.change
// Change makes for its checks.
//
// There is no run template, which will surprise a reader coming from ci.job.
// A ci.job Pipeline exists only to stamp JobRuns, so it carries a JobTemplate
// and nothing else. A Conversion carries the real specification, so a
// ConversionRun snapshots it at creation instead. That snapshot is what keeps
// a finished run reproducible after its Conversion is edited: the run records
// the converter version, the resolved input digests, and the options it
// actually used, not the ones in force today.
//
// Inputs are pinned by digest or followed. A ConversionInput with no digest
// tracks whatever its source currently holds, which is what lets a Conversion
// report itself stale when an upstream schema moves. Once a run is created,
// its digests are always resolved.
// ---------------------------------------------------------------------------
// Shared types
// ---------------------------------------------------------------------------
/// Lifecycle of a ConversionRun.
enum ConversionPhase {
  /// Created, no ci.job JobRun bound yet.
  Pending
  Running
  Succeeded
  Failed
  Cancelled
  /// The run's input_digest already had artifacts, so nothing executed.
  Cached
}

/// What causes a Conversion to materialize a new ConversionRun.
enum ConversionTriggerKind {
  /// A source's digest moved past what the last run consumed.
  InputChanged
  /// The Converter's tool_version was bumped.
  ConverterUpdated
  Schedule
  Manual
}

type ConversionTrigger {
  kind: ConversionTriggerKind
  /// Set only when kind is CONVERSION_TRIGGER_KIND_SCHEDULE.
  schedule: string
}

/// One thing fed to a Converter, bound to one of its input Ports.
type ConversionInput {
  /// Matches a Port.format on the Converter's inputs.
  port: string
  /// Where the bytes come from: a codegen.schema Schema, a vcs.repository
  /// Repository, a vcs.commit Commit.
  source: ref.ObjectReference
  /// Pins the input to one revision. Unset follows the source's current
  /// digest, which is what makes a Conversion go stale rather than diverge
  /// silently. Always set on a ConversionRun.
  digest: string
  /// Narrows the input to part of its source: a subdirectory, a single file.
  subpath: string
}

// ---------------------------------------------------------------------------
// Conversion
// ---------------------------------------------------------------------------
/// A standing instruction to run one Converter over one set of inputs.
type Conversion: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  /// The codegen.converter Converter to run.
  converter: ref.ObjectReference
  inputs: [ConversionInput]
  /// Merged over the Converter's default_options.
  options: {string -> string}
  /// Where output lands. A plain string so it can address a
  /// dev.unmango.protofs path or a repository subdirectory.
  output_uri: string
  /// When to materialize a new run. Empty means only on explicit request.
  triggers: [ConversionTrigger]
  /// Propose the output as a vcs.change Change against this vcs.branch Branch
  /// instead of writing it in place, which is how a generated SDK gets
  /// reviewed before it lands.
  change_target: ref.ObjectReference
  timeout: duration
  max_retries: int32
  // Observed state.
  observed_generation: int
  conditions: [Condition]
  latest_run: ref.ObjectReference
  /// Digest of the primary codegen.artifact Artifact the latest successful run
  /// produced.
  latest_artifact_digest: string
  run_count: int32
  last_success_time: instant
  /// An unpinned input's digest has moved past what latest_run consumed, or
  /// the Converter's tool_version has. The output on disk no longer follows
  /// from the inputs that are declared.
  stale: bool
}

// ---------------------------------------------------------------------------
// ConversionRun
// ---------------------------------------------------------------------------
/// One execution of a Conversion.
type ConversionRun: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  /// The Conversion that materialized this run.
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state, snapshotted from the Conversion at creation so the run
  // stays reproducible after the Conversion is edited.
  converter: ref.ObjectReference
  converter_tool_version: string
  /// Digests are always resolved here, never left to follow.
  inputs: [ConversionInput]
  options: {string -> string}
  output_uri: string
  timeout: duration
  max_retries: int32
  // Assigned desired state.
  /// The ci.job JobRun executing this run. Unset while pending, exactly as an
  /// unscheduled Pod has no node.
  job_run: ref.ObjectReference
  // Observed state.
  observed_generation: int
  phase: ConversionPhase
  conditions: [Condition]
  trigger: ConversionTrigger
  start_time: instant
  completion_time: instant
  /// The codegen.artifact Artifacts this run produced, in the order the
  /// Converter declares its output Ports.
  artifacts: [ref.ObjectReference]
  /// Hash of the resolved inputs, the options, and the converter version
  /// together. Two runs sharing an input_digest should produce identical
  /// artifacts, so the second can resolve the first's output and skip
  /// execution.
  input_digest: string
  /// Set when input_digest already had artifacts and nothing executed.
  cache_hit: bool
  attempt: int32
  logs_uri: string
  output_file_count: int32
  output_bytes: int
}

