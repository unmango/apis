  Artifact {
    resource("unmango.codegen.artifact/Artifact", "artifacts/{artifact}", "artifact", "artifacts")
    reserved(3, 6, 7, 9, 10)  // display_name, owner_refs, generation, update_time, delete_time: nothing declares, owns, or rewrites an artifact
    digest {
      number(1)
