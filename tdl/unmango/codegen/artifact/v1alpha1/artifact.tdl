package unmango.codegen.artifact.v1alpha1

import "../../../../shim/google/type.tdl" as gtype
import "../../../../shim/k8s/meta.tdl" as metav1
import "../../../../shim/rpc.tdl" as rpc
import "../../../../shim/scalar.tdl" as scalar
import "../../../ref/v1alpha1/ref.tdl" as ref

// Generated output as a graph:
//
//   Artifact >> Artifact          (inputs, ordered)
//   codegen.conversion ConversionRun -> Artifact
//
// An Artifact is content-addressed: its digest hashes over the bytes it
// holds, over the converter and version that produced it, and over the
// digests of everything it consumed. Its input edges are therefore fixed at
// creation, because they are part of what the identity covers.
//
// That makes the edge `>>`, the second use of the fifth archetype in this
// repository and the same one vcs.commit uses. Nothing declares an Artifact
// and nothing reconciles it toward a desired state. A run produces it, or
// finds that it already exists. Deleting a consumer never cascades to what
// it consumed, because the consumer's identity depends on the input and not
// the other way around.
//
// A Nix derivation and a git commit are the same shape, which is why the
// field bands here match commit.proto rather than the mutable kinds:
//   1-9    content-addressed identity
//   10-39  content, fixed at creation and covered by the digest
//   50+    derived, computed by whoever indexes the graph
//
// Rebuilding from identical inputs yields the same digest and therefore the
// same node. That is the whole point: it is what lets a
// codegen.conversion ConversionRun resolve its input_digest against the graph
// and skip execution entirely.
//
// Bytes are deliberately absent, for the reason trees and blobs are absent
// from vcs.commit. A generated SDK is a filesystem, and this repository
// already models one, so an Artifact exposes tree_uri, a
// dev.unmango.protofs root, and reading generated output is an ordinary
// filesystem walk rather than a second content model.
// ---------------------------------------------------------------------------
// Shared types
// ---------------------------------------------------------------------------
/// One thing an Artifact was built from. Either another Artifact, which is the
/// `>>` edge, or an external source that was not itself generated.
type ArtifactInput {
  /// What the input was.
  origin: ArtifactInputOrigin
  /// Content hash of the input as consumed. Equals artifact_digest when one is
  /// set, and records the source's digest at consumption time otherwise, so a
  /// moving source cannot rewrite history.
  digest: string
  /// Which codegen.converter Converter input Port this satisfied.
  port: string
}

// tdl-gap: oneof becomes a separate message
enum ArtifactInputOrigin {
  /// Another Artifact's digest. Set when the input was generated by an
  /// earlier conversion, which is what makes the graph a DAG rather than a
  /// flat list.
  ArtifactDigest { artifact_digest: string }
  /// The resource the bytes came from when the input was not generated: a
  /// codegen.schema Schema, a vcs.commit Commit, a vcs.repository Repository.
  Source { source: ref.ObjectReference }
}

// ---------------------------------------------------------------------------
// Artifact
// ---------------------------------------------------------------------------
/// One content-addressed unit of generated output.
///
/// The identity band reserves what an immutable node has no use for,
/// display_name, owner_refs, generation, update_time, and delete_time, rather
/// than compacting around them, so 4 is labels, 5 is annotations, and 8 is
/// create_time here exactly as on every mutable kind.
type Artifact: Entity {
  // Content-addressed identity.
  /// Hash over the content band, and the artifact's name: "sha256:...". There
  /// is no separate name field, no display_name, no owner_refs, no generation,
  /// and no delete_time. Nothing declares an Artifact, so there is nothing to
  /// name it, own it, or revise it.
  digest: string
  uid: uuid
  labels: {string -> string}
  annotations: {string -> string}
  create_time: instant
  // Content, fixed at creation and covered by the digest.
  /// What this was built from. Ordered, and the first is the primary source,
  /// matching the mainline-first convention vcs.commit uses for parents.
  inputs: [ArtifactInput]
  /// The codegen.converter Converter that produced it.
  converter: ref.ObjectReference
  converter_tool_version: string
  options: {string -> string}
  /// Shape of the output, matching the Converter's output Port: "go", "nix",
  /// "kubernetes-crd".
  format: string
  /// Narrows the format, as Port.qualifier does: a Go module path, a Nix
  /// attribute path.
  qualifier: string
  /// A dev.unmango.protofs root holding the generated tree.
  tree_uri: string
  size_bytes: int
  file_count: scalar.int32
  // Derived, computed by whoever indexes the graph.
  conditions: [metav1.Condition]
  /// The codegen.conversion ConversionRuns that reached this digest. Repeated
  /// and derived rather than content: the same inputs can be converted many
  /// times, and which run got there first is not part of the identity.
  produced_by: [ref.ObjectReference]
  /// Artifacts naming this one as an input.
  consumer_count: scalar.int32
  /// Where the bytes are published: an OCI reference, a Nix store path, a BSR
  /// module version. Derived because publishing does not change the content.
  published_uris: [string]
  first_seen_time: instant
  last_produced_time: instant
  /// More than one independent run reached this digest, which is the only
  /// evidence that a Converter's declared determinism holds.
  reproducible: bool
}

type ArtifactService {
  GetArtifact: rpc.Fn<GetArtifactRequest, GetArtifactResponse>
  ListArtifacts: rpc.Fn<ListArtifactsRequest, ListArtifactsResponse>
  WatchArtifacts: rpc.Fn<WatchArtifactsRequest, rpc.Stream<WatchArtifactsResponse>>
  /// Walk the input closure of a set of artifacts. The derivation-graph
  /// equivalent of vcs.commit WalkCommits.
  WalkInputs: rpc.Fn<WalkInputsRequest, rpc.Stream<WalkInputsResponse>>
  /// Walk the other way: everything built from a set of artifacts or sources,
  /// directly or transitively. This is what answers "the upstream schema
  /// moved, what regenerates".
  WalkConsumers: rpc.Fn<WalkConsumersRequest, rpc.Stream<WalkConsumersResponse>>
  /// Whether a set of inputs already has output. The cache lookup a
  /// codegen.conversion ConversionRun performs before executing.
  ResolveInputDigest: rpc.Fn<ResolveInputDigestRequest, ResolveInputDigestResponse>
}

// Create, Update, and Delete are absent. They are not operations that exist
// for a content-addressed object: editing content changes the digest, which
// produces a different Artifact rather than revising this one. Collection is
// a property of the store, not an RPC on the graph.
type GetArtifactRequest {
  /// Full or abbreviated digest.
  digest: string
}

type GetArtifactResponse {
  artifact: Artifact
}

type ListArtifactsRequest {
  page_size: scalar.int32
  page_token: string
  selector: metav1.LabelSelector
  /// Field 4 is `converter` rather than the `owner` this position holds on
  /// every mutable kind. An artifact has no owner reference to list by; the
  /// converter is provenance, not ownership.
  converter: ref.ObjectReference
  /// Restricts results to artifacts in this output format.
  format: string
  /// Restricts results to artifacts first seen within this window.
  window: gtype.Interval
  /// Restricts results to artifacts consuming this input, by digest or by
  /// source reference. Only one level deep; WalkConsumers goes transitive.
  consumes: ArtifactInput
  /// Exclude artifacts nothing consumes and nothing published.
  reachable_only: bool
}

type ListArtifactsResponse {
  artifacts: [Artifact]
  next_page_token: string
}

type WatchArtifactsRequest {
  selector: metav1.LabelSelector
  converter: ref.ObjectReference
  /// Resume from this point instead of the current state, so a client that
  /// drops the stream does not have to replay from nothing. Unset starts
  /// from now.
  resource_version: string
}

type WatchArtifactsResponse {
  type: ArtifactEventType
  /// Unset on a BOOKMARK event, which carries only the resume point.
  artifact: Artifact
  /// Resume point as of this event. A client stores it and sends it back as
  /// WatchArtifactsRequest.resource_version after a dropped stream, so the
  /// request's resume token has somewhere to come from.
  resource_version: string
}

/// An artifact is never modified, so the event set is narrower than the
/// mutable kinds, and matches vcs.commit for the same reason. ADDED is an
/// artifact becoming visible; UNREACHABLE is one nothing consumes any more;
/// DELETED is one collected from the store.
enum ArtifactEventType {
  Added
  Unreachable
  Deleted
  /// No change to any artifact. Carries a resource_version so an idle
  /// stream still advances the client's resume point, rather than leaving it
  /// pinned at the last real event. This is the Kubernetes BOOKMARK event.
  Bookmark
}

type WalkInputsRequest {
  /// Where the walk begins.
  start_digests: [string]
  /// Boundaries. Nothing reachable from these is emitted, which is how a walk
  /// expresses "everything this needs that the base image does not already
  /// provide".
  exclude_digests: [string]
  /// Stop after this many edges from the nearest start. Zero means unbounded.
  max_depth: scalar.int32
  /// Stop after this many artifacts. Zero means unbounded.
  limit: scalar.int32
  /// Emit only artifacts in one of these output formats. Empty emits all.
  formats: [string]
  /// Emit only artifacts produced by one of these Converters.
  converters: [ref.ObjectReference]
  /// Emit the external sources at the edge of the closure as well, as inputs
  /// with no artifact_digest. Off by default, since a closure is usually asked
  /// for in terms of what was built.
  include_sources: bool
}

type WalkInputsResponse {
  /// The node reached by this edge.
  node: WalkInputsResponseNode
  /// Edges traversed from the nearest start digest to reach this node.
  depth: scalar.int32
}

// tdl-gap: oneof becomes a separate message
enum WalkInputsResponseNode {
  Artifact { artifact: Artifact }
  /// The node is an external source at the edge of the closure, which only
  /// happens with include_sources.
  Source { source: ArtifactInput }
}

type WalkConsumersRequest {
  /// Artifacts to walk forward from.
  start_digests: [string]
  /// Sources to walk forward from, for the case that matters most: an upstream
  /// codegen.schema Schema or vcs.commit Commit that just moved, which is not
  /// itself an Artifact.
  start_sources: [ref.ObjectReference]
  max_depth: scalar.int32
  limit: scalar.int32
  formats: [string]
  /// Emit only artifacts something published, which narrows an impact walk to
  /// what consumers outside the graph can actually see.
  published_only: bool
}

type WalkConsumersResponse {
  artifact: Artifact
  depth: scalar.int32
  /// The codegen.conversion Conversions that would need re-running to rebuild
  /// this artifact. Carried on the walk so an impact query returns the work to
  /// do alongside the damage.
  conversions: [ref.ObjectReference]
}

type ResolveInputDigestRequest {
  /// The hash a codegen.conversion ConversionRun computed over its resolved
  /// inputs, options, and converter version.
  input_digest: string
  /// Restricts the lookup to one output format, for a converter declaring more
  /// than one output Port.
  format: string
}

type ResolveInputDigestResponse {
  /// Empty when nothing has been built from these inputs, which is the signal
  /// to execute.
  artifacts: [Artifact]
}

target protobuf for unmango.codegen.artifact.v1alpha1 {
  out("gen/tdl")
  edition("2024")
  ArtifactInput {
