package unmango.calendar.event.v1alpha1

import "../../../../shim/google/type.tdl" as _
import "../../../../shim/k8s/meta.tdl" as _
import "../../../ref/v1alpha1/ref.tdl" as ref

// Scheduled time, and who is coming:
//
//   RecurringEvent -> Event @ asset.property Space
//                       ^~ Attendance ~> people.contact Contact
//
// A RecurringEvent materializes concrete Events up to a bounded horizon, so a
// weekly standing meeting is a template plus a horizon rather than an infinite
// series. Editing the series affects future occurrences; an occurrence that
// has been individually modified detaches and is left alone.
//
// Attendance is its own kind attached to the Event rather than a field on it.
// That is the Gateway -> HTTPRoute shape, and it is what lets an invitee
// respond without holding write access to the event, and lets the event admit
// or reject them independently.
// ---------------------------------------------------------------------------
// Shared types
// ---------------------------------------------------------------------------
enum EventState { Confirmed Tentative Cancelled }

enum Transparency {
  /// Consumes the attendee's availability.
  Busy
  /// Visible but does not block other bookings.
  Free
}

enum RecurrenceFrequency { Daily Weekly Monthly Yearly }

/// How a series repeats. Follows RFC 5545 recurrence semantics without
/// inheriting its string encoding.
type RecurrenceRule {
  frequency: RecurrenceFrequency
  /// Periods between occurrences. Two with WEEKLY means fortnightly.
  interval: int32
  /// Days the rule fires. WEEKLY only.
  by_day: [DayOfWeek]
  /// Days of the month, 1 to 31, or negative to count back from the end.
  /// MONTHLY and YEARLY only.
  by_month_day: [int32]
  /// Stop after this many occurrences. Zero means unbounded.
  count: int32
  /// Stop on this date. Unset means unbounded.
  until: Date
  /// Dates to skip, for a series with holes in it.
  exclude_dates: [Date]
  /// Schedule the next occurrence relative to when the last one was completed
  /// rather than when it was due. Mirrors productivity.task's copy of this
  /// field; keep the two in sync when either changes.
  from_completion: bool
}

enum AttendeeResponse { NeedsAction Accepted Declined Tentative }

// ---------------------------------------------------------------------------
// Attendance
// ---------------------------------------------------------------------------
/// One person's relationship to one Event. Authored independently of the Event
/// and admitted by it.
type Attendance: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  /// The Event being attended. The Event decides whether to admit this.
  parent_ref: ref.ParentReference
  /// The people.contact Contact attending.
  attendee: ref.ObjectReference
  response: AttendeeResponse
  /// Attendance is expected rather than optional.
  required: bool
  /// Chairs the event. At most one attendance per event should set this.
  organizer: bool
  comment: string
  // Observed state.
  observed_generation: int
  /// Reports whether the Event admitted this attendance, and why not when it
  /// did not.
  conditions: [Condition]
  responded_time: instant
  /// Whether the attendee is double-booked over this event's interval.
  conflicting: bool
}

// ---------------------------------------------------------------------------
// Event
// ---------------------------------------------------------------------------
/// A single occurrence of scheduled time.
type Event: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Templated desired state. EventTemplate mirrors 10-39.
  summary: string
  description: string
  /// Free-text location, for somewhere with no modelled Space.
  location: string
  transparency: Transparency
  /// Occupies whole days, so the interval's times carry no meaning.
  all_day: bool
  /// How far ahead to notify. Multiple entries give multiple reminders.
  reminders: [duration]
  /// IANA identifier, retained so a recurring series survives daylight saving
  /// shifts: "America/Chicago".
  time_zone: string
  conference_uri: string
  // Assigned desired state.
  /// When it happens. Computed per occurrence for a materialized event.
  when: Interval
  /// The asset.property Space booked for it. Unset means no room is held.
  space: ref.ObjectReference
  /// Date within the series this occurrence stands for. Set on materialized
  /// events, so an occurrence stays identifiable after it is moved.
  occurrence_date: Date
  /// This occurrence was edited individually and no longer tracks its series.
  detached: bool
  // Observed state.
  observed_generation: int
  state: EventState
  conditions: [Condition]
  attendance_count: int32
  accepted_count: int32
  declined_count: int32
  pending_count: int32
  /// Another Event overlaps this one for a shared attendee or the booked Space.
  conflicting: bool
}

/// Desired state stamped onto Events generated by a RecurringEvent. Field
/// numbers mirror Event 10-39; the assigned band is absent because the interval
/// and room booking are computed per occurrence.
type EventTemplate {
  labels: {string -> string}
  annotations: {string -> string}
  summary: string
  description: string
  location: string
  transparency: Transparency
  all_day: bool
  reminders: [duration]
  time_zone: string
  conference_uri: string
}

// ---------------------------------------------------------------------------
// RecurringEvent
// ---------------------------------------------------------------------------
/// A repeating series, and the owner of every Event it materializes.
type RecurringEvent: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  /// Stamped onto each materialized Event.
  template: EventTemplate
  rule: RecurrenceRule
  /// Local time each occurrence starts, interpreted in template.time_zone.
  start_date: Date
  /// Seconds after midnight local time. Ignored when the template is all_day.
  start_seconds: int32
  duration: duration
  /// Materialize occurrences up to this date, bounding how far ahead the chain
  /// runs rather than generating an unbounded series.
  materialize_through: Date
  /// Which Events this series claims. Detached occurrences drop out of it.
  selector: LabelSelector
  /// The Space every occurrence books, when the series holds a standing room.
  space: ref.ObjectReference
  /// Stop materializing without deleting the series.
  suspended: bool
  /// Past occurrences to retain. Zero retains all.
  occurrence_history_limit: int32
  // Observed state.
  observed_generation: int
  conditions: [Condition]
  occurrence_count: int32
  /// Occurrences that were edited individually and no longer track the series.
  detached_count: int32
  next_occurrence_date: Date
  materialized_through: Date
  /// Latest revision of the template. Occurrences record the revision they were
  /// created with.
  revision: string
}

