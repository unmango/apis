package unmango.health.training.v1alpha1

import "../../../../shim/google/type.tdl" as gtype
import "../../../../shim/k8s/meta.tdl" as metav1
import "../../../../shim/scalar.tdl" as scalar
import "../../../ref/v1alpha1/ref.tdl" as ref

// Physical training, from intent down to what actually happened:
//
//   TrainingPlan -> Workout -> Activity
//
// A TrainingPlan holds a cycle of workout templates and materializes them onto
// dates. A Workout is one planned session. An Activity is the record of
// performing it.
//
// An Activity with no owner is an unplanned session. That is the honest
// encoding, and it keeps the common case, going for a run because the weather
// was good, from being forced through a plan that never existed.
// ---------------------------------------------------------------------------
// Shared types
// ---------------------------------------------------------------------------
enum ActivityType { Run Walk Hike Ride Swim Row Strength Mobility Climb Sport Rest }

enum WorkoutPhase {
  /// Materialized onto a date, not yet reached.
  Planned
  InProgress
  Completed
  /// Deliberately passed over.
  Skipped
  /// The date passed with nothing recorded.
  Missed
}

enum Intensity { Recovery Easy Moderate Hard Maximal }

/// One prescribed or performed block of resistance work.
type StrengthSet {
  exercise: string
  reps: scalar.int32
  weight_kg: scalar.double
  /// Reps left before failure. The usual way effort is logged.
  reps_in_reserve: scalar.int32
  rest: duration
}

/// What a Workout asks for. Any unset target is unconstrained.
type Targets {
  duration: duration
  distance_meters: scalar.double
  intensity: Intensity
  heart_rate_bpm: scalar.int32
  /// Seconds per kilometre.
  pace_seconds_per_km: scalar.int32
  sets: [StrengthSet]
}

// ---------------------------------------------------------------------------
// Activity
// ---------------------------------------------------------------------------
/// A session that was actually performed. The leaf of the chain, and the only
/// kind here that records fact rather than intent.
type Activity: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  /// The Workout this fulfils. Absent for an unplanned session.
  owner_refs: [metav1.OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state. Recorded facts rather than intent, since an Activity is
  // authored after the event.
  type: ActivityType
  when: gtype.Interval
  /// Elapsed time excluding pauses.
  moving_duration: duration
  distance_meters: scalar.double
  elevation_gain_meters: scalar.double
  calories_kcal: scalar.int32
  average_heart_rate_bpm: scalar.int32
  max_heart_rate_bpm: scalar.int32
  sets: [StrengthSet]
  /// Borg CR10, 1 to 10.
  perceived_exertion: scalar.int32
  notes: string
  /// Where the GPS track or device file lives. A plain string so it can
  /// address a dev.unmango.protofs path without coupling the packages.
  route_uri: string
  device: string
  // Observed state. Derived rather than recorded.
  observed_generation: int
  conditions: [metav1.Condition]
  /// Seconds per kilometre, from distance and moving duration.
  pace_seconds_per_km: scalar.int32
  /// Duration weighted by intensity, comparable across activity types.
  training_load: scalar.double
  /// Total volume of resistance work: sum of reps times weight.
  total_volume_kg: scalar.double
  /// Whether the owning Workout's targets were met.
  targets_met: bool
}

// ---------------------------------------------------------------------------
// Workout
// ---------------------------------------------------------------------------
/// One planned session, materialized onto a date. Owns the Activity that
/// fulfils it.
type Workout: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [metav1.OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Templated desired state. WorkoutTemplate mirrors 10-39.
  type: ActivityType
  summary: string
  targets: Targets
  instructions: string
  /// Missing this breaks the plan's progression rather than just the week.
  key_session: bool
  /// Which Activities this Workout claims.
  selector: metav1.LabelSelector
  // Assigned desired state. Computed when the occurrence is materialized.
  scheduled_date: gtype.Date
  /// Position within the plan's cycle, so a week's shape is recoverable.
  cycle_index: scalar.int32
  /// The calendar.event Event booked for it.
  scheduled_event: ref.ObjectReference
  // Observed state.
  observed_generation: int
  phase: WorkoutPhase
  conditions: [metav1.Condition]
  /// The Activity that fulfilled this, once performed.
  activity: ref.ObjectReference
  completed_date: gtype.Date
  /// Achieved divided by targeted, across whichever targets were set.
  target_attainment: scalar.double
  training_load: scalar.double
}

/// Desired state stamped onto Workouts generated by a TrainingPlan. Field
/// numbers mirror Workout 10-39; the assigned band is absent because dates are
/// computed per cycle.
type WorkoutTemplate {
  labels: {string -> string}
  annotations: {string -> string}
  /// Day within the plan's cycle this template fires on, zero-based.
  cycle_offset_days: scalar.int32
  type: ActivityType
  summary: string
  targets: Targets
  instructions: string
  key_session: bool
  /// Which Activities a generated Workout claims.
  selector: metav1.LabelSelector
}

// ---------------------------------------------------------------------------
// TrainingPlan
// ---------------------------------------------------------------------------
/// A repeating cycle of sessions. The kind a human edits, and the owner of
/// every Workout it materializes.
type TrainingPlan: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [metav1.OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  /// One template per session in the cycle, each placed by its
  /// cycle_offset_days. Seven templates over a seven day cycle is a week.
  workouts: [WorkoutTemplate]
  /// Length of one repetition of the cycle.
  cycle_length_days: scalar.int32
  start_date: gtype.Date
  /// Unset means indefinitely.
  end_date: gtype.Date
  /// Materialize workouts up to this date, bounding how far ahead the chain
  /// runs.
  materialize_through: gtype.Date
  /// Which Workouts this plan claims.
  selector: metav1.LabelSelector
  /// What the plan is building toward.
  focus: ActivityType
  /// The event being trained for, expressed as a target date.
  goal_date: gtype.Date
  /// Stop materializing without deleting the plan. What an injury looks like.
  suspended: bool
  /// Completed workouts to retain. Zero retains all. Their Activities are never
  /// reaped, since those are the durable history.
  workout_history_limit: scalar.int32
  // Observed state.
  observed_generation: int
  conditions: [metav1.Condition]
  planned_workout_count: scalar.int32
  completed_workout_count: int
  skipped_workout_count: int
  missed_workout_count: int
  /// Completed divided by materialized, over the retained history.
  adherence_rate: scalar.double
  next_workout_date: gtype.Date
  materialized_through: gtype.Date
  /// Training load summed over the trailing seven days.
  weekly_load: scalar.double
  /// Latest revision of the workout set.
  revision: string
}

target protobuf for unmango.health.training.v1alpha1 {
  out("gen/tdl")
  edition("2024")
  StrengthSet {
    exercise => number(1)
    reps => number(2)
