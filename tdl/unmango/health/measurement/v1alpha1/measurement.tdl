package unmango.health.measurement.v1alpha1

import "../../../../shim/google/type.tdl" as gtype
import "../../../../shim/k8s/meta.tdl" as metav1
import "../../../../shim/scalar.tdl" as scalar
import "../../../ref/v1alpha1/ref.tdl" as ref
import "../../../uom/v1alpha1/uom.tdl" as uom

// Recorded body and health observations, and the targets set against them:
//
//   Goal => Measurement
//
// A Goal claims Measurements by label selector rather than owning them. That
// is the Service -> Pods relationship, and it is the right shape here: a
// measurement is a fact that exists whether or not anyone is tracking it, and
// several goals may watch the same series without competing for it.
//
// A Measurement carries repeated Components rather than a single value, so
// blood pressure, which is two numbers, and body weight, which is one, are the
// same kind. Splitting them into separate kinds per shape would multiply the
// API for no gain.
// ---------------------------------------------------------------------------
// Shared types
// ---------------------------------------------------------------------------
enum MeasurementType {
  Weight
  BodyFat
  LeanMass
  BloodPressure
  RestingHeartRate
  HeartRateVariability
  Sleep
  BloodGlucose
  Temperature
  BloodOxygen
  Circumference
  Vo2Max
  LabPanel
}

/// One number within a Measurement. A weight has one; a blood pressure has
/// systolic and diastolic; a lab panel has many.
type Component {
  /// "systolic", "diastolic", "waist", "hdl".
  name: string
  value: scalar.double
  unit: uom.Unit
  /// Set only when unit is UNIT_CUSTOM.
  custom_unit: string
  /// Healthy range for this component, when one is known.
  reference_low: scalar.double
  reference_high: scalar.double
}

enum GoalDirection {
  /// Lower is better.
  Decrease
  /// Higher is better.
  Increase
  /// Stay within a band.
  Maintain
}

enum GoalPhase {
  /// Set, but no matching measurement recorded yet.
  Pending
  OnTrack
  OffTrack
  Achieved
  /// Target date passed without being met.
  Missed
  Abandoned
}

// ---------------------------------------------------------------------------
// Measurement
// ---------------------------------------------------------------------------
/// One observation, at one moment. Append-only in practice: a wrong reading is
/// superseded rather than edited.
type Measurement: Entity {
  name: string
  uid: uuid
  display_name: string
  /// Also the surface a Goal selector matches against.
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [metav1.OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state. Recorded facts, since a Measurement is authored after the
  // observation.
  type: MeasurementType
  observed_time: instant
  /// The numbers. One entry for a scalar reading, several for a composite.
  components: [Component]
  /// What took the reading: a scale, a wearable, a lab, or a person.
  source: string
  source_device: ref.ObjectReference
  notes: string
  /// Conditions the reading was taken under, which determine whether two
  /// readings are comparable: "fasted", "post-workout", "morning".
  context: [string]
  // Observed state.
  observed_generation: int
  conditions: [metav1.Condition]
  /// Goals whose selectors currently claim this measurement. Makes the selector
  /// edge navigable from the measurement side.
  claimed_by: [ref.ObjectReference]
  /// Change from the previous comparable reading of the same type.
  delta: [Component]
  /// A component fell outside its reference range.
  out_of_reference_range: bool
  /// A later reading of the same type and context replaced this one.
  superseded: bool
}

// ---------------------------------------------------------------------------
// Goal
// ---------------------------------------------------------------------------
/// A target set against a series of Measurements, claimed by selector.
type Goal: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [metav1.OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  /// Which Measurements count toward this goal. Selection rather than
  /// ownership: the measurements exist independently and several goals may
  /// watch the same series.
  selector: metav1.LabelSelector
  /// Narrows the selector to one kind of reading.
  measurement_type: MeasurementType
  /// Which component of the reading the target applies to.
  component: string
  direction: GoalDirection
  target_value: scalar.double
  /// Acceptable band around the target, for MAINTAIN.
  tolerance: scalar.double
  unit: uom.Unit
  /// Set only when unit is UNIT_CUSTOM.
  custom_unit: string
  /// Value at the time the goal was set, so progress is measurable rather than
  /// only distance-to-target.
  baseline_value: scalar.double
  start_date: gtype.Date
  /// Unset means open-ended.
  target_date: gtype.Date
  /// Readings to average before comparing against the target, which keeps day
  /// to day noise from flipping the phase.
  smoothing_window: scalar.int32
  // Observed state.
  observed_generation: int
  phase: GoalPhase
  conditions: [metav1.Condition]
  matched_measurement_count: scalar.int32
  /// Latest claimed reading of the tracked component.
  current_value: scalar.double
  /// Smoothed over the window.
  smoothed_value: scalar.double
  last_measured_time: instant
  /// Distance travelled from baseline toward target, 0.0 to 1.0. Above 1.0
  /// means overshot.
  progress: scalar.double
  /// Change per day over the smoothing window. Sign is relative to direction,
  /// so positive always means improving.
  rate_per_day: scalar.double
  /// When the current rate would reach the target. Unset if moving away from
  /// it.
  projected_date: gtype.Date
}

target protobuf for unmango.health.measurement.v1alpha1 {
  out("gen/tdl")
  edition("2024")
  Component {
    name => number(1)
    value => number(2)
    unit => number(3)
    custom_unit {
      number(6)
      field_behavior(OPTIONAL)
    }
    reference_low {
      number(4)
      field_behavior(OPTIONAL)
    }
    reference_high {
      number(5)
      field_behavior(OPTIONAL)
    }
  }
  Measurement {
    resource("unmango.health.measurement/Measurement", "measurements/{measurement}", "measurement", "measurements")
    name {
      number(1)
      field_behavior(IDENTIFIER)
    }
    uid {
      number(2)
      field_behavior(OUTPUT_ONLY)
      field_info(UUID4)
    }
    display_name {
      number(3)
      field_behavior(OPTIONAL)
    }
    labels => number(4)
    annotations => number(5)
    owner_refs => number(6)
    generation {
      number(7)
      field_behavior(OUTPUT_ONLY)
    }
    create_time {
      number(8)
      field_behavior(OUTPUT_ONLY)
    }
    update_time {
      number(9)
      field_behavior(OUTPUT_ONLY)
    }
    delete_time {
      number(10)
      field_behavior(OUTPUT_ONLY)
    }
    type => number(11)
    observed_time => number(12)
    components => number(13)
    source => number(14)
    source_device {
      number(15)
      field_behavior(OPTIONAL)
      resource_reference("*")
    }
    notes {
      number(16)
      field_behavior(OPTIONAL)
    }
    context => number(17)
    observed_generation {
      number(50)
      field_behavior(OUTPUT_ONLY)
    }
    conditions {
      number(51)
      field_behavior(OUTPUT_ONLY)
    }
    claimed_by {
      number(52)
      field_behavior(OUTPUT_ONLY)
      resource_reference("unmango.health.measurement/Goal")
    }
    delta {
      number(53)
      field_behavior(OUTPUT_ONLY)
    }
    out_of_reference_range {
      number(54)
      field_behavior(OUTPUT_ONLY)
    }
    superseded {
      number(55)
      field_behavior(OUTPUT_ONLY)
    }
  }
  Goal {
    resource("unmango.health.measurement/Goal", "goals/{goal}", "goal", "goals")
    name {
      number(1)
      field_behavior(IDENTIFIER)
    }
    uid {
      number(2)
      field_behavior(OUTPUT_ONLY)
      field_info(UUID4)
    }
    display_name {
      number(3)
      field_behavior(OPTIONAL)
    }
    labels => number(4)
    annotations => number(5)
    owner_refs => number(6)
    generation {
      number(7)
      field_behavior(OUTPUT_ONLY)
    }
    create_time {
      number(8)
      field_behavior(OUTPUT_ONLY)
    }
    update_time {
      number(9)
      field_behavior(OUTPUT_ONLY)
    }
    delete_time {
      number(10)
      field_behavior(OUTPUT_ONLY)
    }
    selector => number(11)
    measurement_type => number(12)
    component => number(13)
    direction => number(14)
    target_value => number(15)
    tolerance => number(16)
    unit => number(17)
    custom_unit {
      number(22)
      field_behavior(OPTIONAL)
    }
    baseline_value {
      number(18)
      field_behavior(OPTIONAL)
    }
    start_date => number(19)
    target_date {
      number(20)
      field_behavior(OPTIONAL)
    }
    smoothing_window => number(21)
    observed_generation {
      number(50)
      field_behavior(OUTPUT_ONLY)
    }
    phase {
      number(51)
      field_behavior(OUTPUT_ONLY)
    }
    conditions {
      number(52)
      field_behavior(OUTPUT_ONLY)
    }
    matched_measurement_count {
      number(53)
      field_behavior(OUTPUT_ONLY)
    }
    current_value {
      number(54)
      field_behavior(OUTPUT_ONLY)
    }
    smoothed_value {
      number(55)
      field_behavior(OUTPUT_ONLY)
    }
    last_measured_time {
      number(56)
      field_behavior(OUTPUT_ONLY)
    }
    progress {
      number(57)
      field_behavior(OUTPUT_ONLY)
    }
    rate_per_day {
      number(58)
      field_behavior(OUTPUT_ONLY)
    }
    projected_date {
      number(59)
      field_behavior(OUTPUT_ONLY)
    }
  }
}
