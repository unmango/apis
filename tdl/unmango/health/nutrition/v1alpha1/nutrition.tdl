package unmango.health.nutrition.v1alpha1

import "../../../../shim/google/type.tdl" as _
import "../../../../shim/k8s/meta.tdl" as _
import "../../../ref/v1alpha1/ref.tdl" as ref
import "../../../uom/v1alpha1/uom.tdl" as uom

// What gets eaten, planned and recorded:
//
//   MealPlan -> Meal -> FoodEntry ~> Food
//
// Food is a catalog kind with its own lifetime: it is referenced by entries
// rather than owned by them, so correcting a food's nutrition data fixes every
// meal that used it rather than only the next one.
//
// FoodEntry attaches to a Food and is owned by a Meal. It carries the portion,
// which is the part that varies, while the Food carries the per-serving facts,
// which do not.
// ---------------------------------------------------------------------------
// Shared types
// ---------------------------------------------------------------------------
enum MealType { Breakfast Lunch Dinner Snack Drink }

enum MealPhase {
  /// Materialized from a plan, not yet eaten.
  Planned
  Eaten
  /// Deliberately passed over.
  Skipped
  /// Replaced by something not in the plan.
  Substituted
}

/// Macro and micro nutrients for one serving, or summed across a meal.
type Nutrients {
  calories_kcal: float64
  protein_g: float64
  carbohydrate_g: float64
  fat_g: float64
  fiber_g: float64
  sugar_g: float64
  saturated_fat_g: float64
  sodium_mg: float64
  cholesterol_mg: float64
  potassium_mg: float64
}

/// A portion size the food is commonly measured in.
type Serving {
  unit: uom.Unit
  /// Set only when unit is UNIT_CUSTOM: "slice", "medium".
  custom_unit: string
  grams: float64
  /// Nutrients in exactly one of this serving.
  nutrients: Nutrients
}

// ---------------------------------------------------------------------------
// Food
// ---------------------------------------------------------------------------
/// A catalog entry: an ingredient, a packaged product, or a prepared dish.
/// Referenced by FoodEntry rather than owned by it, so it can be corrected once
/// and take effect everywhere.
type Food: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  brand: string
  /// Portions this food can be measured in. The first is the default.
  servings: [Serving]
  barcode: string
  /// Where the nutrition data came from: "usda", "label", "estimated".
  source: string
  /// Composed of other Foods, as a recipe is.
  ingredients: [Ingredient]
  /// Servings the whole recipe yields. Only meaningful with ingredients.
  recipe_yield: float64
  typical_cost: Money
  // Observed state.
  observed_generation: int
  conditions: [Condition]
  /// Summed from ingredients and divided by yield, for a recipe. Copied from
  /// the default serving otherwise.
  computed_nutrients: Nutrients
  /// FoodEntries currently referencing this food.
  reference_count: int
  last_eaten_time: instant
}

/// One component of a recipe.
type Ingredient {
  food: ref.ObjectReference
  quantity: float64
  unit: uom.Unit
  /// Set only when unit is UNIT_CUSTOM.
  custom_unit: string
}

// ---------------------------------------------------------------------------
// FoodEntry
// ---------------------------------------------------------------------------
/// One portion of one Food within a Meal. Owned by the Meal, attached to the
/// Food.
type FoodEntry: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  /// The catalog Food eaten. Attachment rather than ownership: the entry
  /// records a portion, the Food records the facts.
  food_ref: ref.ParentReference
  quantity: float64
  /// Which of the Food's servings the quantity is counted in.
  unit: uom.Unit
  note: string
  /// Set only when unit is UNIT_CUSTOM.
  custom_unit: string
  // Observed state.
  observed_generation: int
  conditions: [Condition]
  /// The Food's per-serving nutrients scaled by quantity.
  nutrients: Nutrients
  grams: float64
  cost: Money
}

/// Desired state stamped onto FoodEntries generated by a Meal template. Field
/// numbers mirror FoodEntry 10-39.
type FoodEntryTemplate {
  labels: {string -> string}
  annotations: {string -> string}
  food_ref: ref.ParentReference
  quantity: float64
  unit: uom.Unit
  note: string
  custom_unit: string
}

// ---------------------------------------------------------------------------
// Meal
// ---------------------------------------------------------------------------
/// One sitting. Owns the FoodEntries that make it up.
type Meal: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Templated desired state. MealTemplate mirrors 10-39.
  type: MealType
  /// Entries to materialize. Editing this changes what the meal consists of.
  entries: [FoodEntryTemplate]
  /// Which FoodEntries this Meal claims.
  selector: LabelSelector
  notes: string
  /// Nutrient budget for this sitting, against which totals are compared.
  targets: Nutrients
  // Assigned desired state.
  meal_date: Date
  /// Seconds after midnight local time. Zero means unrecorded.
  meal_seconds: int32
  // Observed state.
  observed_generation: int
  phase: MealPhase
  conditions: [Condition]
  entry_count: int32
  /// Summed over child FoodEntries.
  totals: Nutrients
  cost: Money
  eaten_time: instant
  /// Totals divided by targets, across whichever targets were set.
  target_attainment: float64
}

/// Desired state stamped onto Meals generated by a MealPlan. Field numbers
/// mirror Meal 10-39; the assigned band is absent because dates are computed
/// per cycle.
type MealTemplate {
  labels: {string -> string}
  annotations: {string -> string}
  /// Day within the plan's cycle this template fires on, zero-based.
  cycle_offset_days: int32
  type: MealType
  entries: [FoodEntryTemplate]
  /// Which FoodEntries a generated Meal claims.
  selector: LabelSelector
  notes: string
  targets: Nutrients
}

// ---------------------------------------------------------------------------
// MealPlan
// ---------------------------------------------------------------------------
/// A repeating cycle of meals. The kind a human edits, and the owner of every
/// Meal it materializes.
type MealPlan: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  /// One template per sitting in the cycle, each placed by its
  /// cycle_offset_days.
  meals: [MealTemplate]
  cycle_length_days: int32
  start_date: Date
  end_date: Date
  /// Materialize meals up to this date, bounding how far ahead the chain runs.
  materialize_through: Date
  /// Which Meals this plan claims.
  selector: LabelSelector
  /// Nutrient budget for a whole day, against which each day is compared.
  daily_targets: Nutrients
  suspended: bool
  /// Eaten meals to retain. Zero retains all.
  meal_history_limit: int32
  // Observed state.
  observed_generation: int
  conditions: [Condition]
  planned_meal_count: int32
  eaten_meal_count: int
  skipped_meal_count: int
  /// Eaten divided by materialized, over the retained history.
  adherence_rate: float64
  /// Averaged over the trailing seven days.
  average_daily_totals: Nutrients
  average_daily_cost: Money
  materialized_through: Date
  revision: string
}

target protobuf for unmango.health.nutrition.v1alpha1 {
  out("../../../../../proto")
