package unmango.productivity.habit.v1alpha1

import "../../../../shim/k8s/meta.tdl" as metav1
import "../../../../shim/scalar.tdl" as scalar
import "../../../uom/v1alpha1/uom.tdl" as uom

// A behavior tracked by logging it, not by scheduling it:
//
//   Habit -> HabitLog
//
// productivity.task RecurringTask already materializes a full Task, due
// date, subtasks, dependencies, every period; its skip_missed field even
// says so directly: "What a daily habit wants." That is the wrong shape for
// "did I meditate today": there is no due date, no subtask, nothing to
// triage, only whether it happened. A Habit never materializes a Task.
// Logging is direct: a HabitLog is created the moment the behavior happens,
// and current_streak is computed from the log history against frequency and
// target_count, not from completed occurrences of a generated child.
//
// Habit and HabitLog follow FocusSession and Interruption's shape, an owned
// child with a full identity band and a minimal observed band, rather than
// CaptureItem's reserved-band shape: a HabitLog genuinely is owned by its
// Habit, unlike a CaptureItem, which nothing owns.
// ---------------------------------------------------------------------------
// Shared types
// ---------------------------------------------------------------------------
enum HabitFrequency {
  Daily
  /// target_count times per week.
  Weekly
  /// target_count times per month.
  Monthly
}

// ---------------------------------------------------------------------------
// Habit
// ---------------------------------------------------------------------------
/// A behavior worth doing regularly, tracked by its log rather than by
/// materializing scheduled work.
type Habit: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [metav1.OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  description: string
  frequency: HabitFrequency
  /// Occurrences per frequency period.
  target_count: scalar.int32
  /// Set only when this habit tracks an amount, e.g. "8 cups water".
  target_quantity: uom.Quantity
  reminder_lead_time: duration
  /// Stop expecting occurrences without deleting the habit.
  paused: bool
  start_time: instant
  // Observed state.
  observed_generation: int
  conditions: [metav1.Condition]
  /// Consecutive frequency periods meeting target_count.
  current_streak: scalar.int32
  longest_streak: scalar.int32
  /// Periods meeting target_count divided by periods elapsed since start_time.
  completion_rate: scalar.double
  last_logged_time: instant
  total_log_count: scalar.int32
}

/// One occurrence of a Habit, logged when it happens.
type HabitLog: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  /// The Habit this occurrence belongs to.
  owner_refs: [metav1.OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  /// When the habit was actually done. May predate create_time for a
  /// backfilled log.
  logged_time: instant
  /// Set only when the owning Habit tracks target_quantity.
  quantity: uom.Quantity
  note: string
  // Observed state.
  observed_generation: int
  conditions: [metav1.Condition]
}

target protobuf for unmango.productivity.habit.v1alpha1 {
  out("gen/tdl")
  edition("2024")
  Habit {
    resource("unmango.productivity.habit/Habit", "habits/{habit}", "habit", "habits")
    name {
      number(1)
      field_behavior(IDENTIFIER)
    }
    uid {
      number(2)
      field_behavior(OUTPUT_ONLY)
      field_info(UUID4)
    }
    display_name {
      number(3)
      field_behavior(OPTIONAL)
    }
    labels => number(4)
    annotations => number(5)
    owner_refs => number(6)
    generation {
      number(7)
      field_behavior(OUTPUT_ONLY)
    }
    create_time {
      number(8)
      field_behavior(OUTPUT_ONLY)
    }
    update_time {
      number(9)
      field_behavior(OUTPUT_ONLY)
    }
    delete_time {
      number(10)
      field_behavior(OUTPUT_ONLY)
    }
    description {
      number(11)
      field_behavior(OPTIONAL)
    }
    frequency => number(12)
    target_count => number(13)
    target_quantity {
      number(14)
      field_behavior(OPTIONAL)
    }
    reminder_lead_time {
      number(15)
      field_behavior(OPTIONAL)
    }
    paused => number(16)
    start_time {
      number(17)
      field_behavior(OPTIONAL)
    }
    observed_generation {
      number(50)
      field_behavior(OUTPUT_ONLY)
    }
    conditions {
      number(51)
      field_behavior(OUTPUT_ONLY)
    }
    current_streak {
      number(52)
      field_behavior(OUTPUT_ONLY)
    }
    longest_streak {
      number(53)
      field_behavior(OUTPUT_ONLY)
    }
    completion_rate {
      number(54)
      field_behavior(OUTPUT_ONLY)
    }
    last_logged_time {
      number(55)
      field_behavior(OUTPUT_ONLY)
    }
    total_log_count {
      number(56)
      field_behavior(OUTPUT_ONLY)
    }
  }
  HabitLog {
    resource("unmango.productivity.habit/HabitLog", "habitLogs/{habit_log}", "habitLog", "habitLogs")
    name {
      number(1)
      field_behavior(IDENTIFIER)
    }
    uid {
      number(2)
      field_behavior(OUTPUT_ONLY)
      field_info(UUID4)
    }
    display_name {
      number(3)
      field_behavior(OPTIONAL)
    }
    labels => number(4)
    annotations => number(5)
    owner_refs => number(6)
    generation {
      number(7)
      field_behavior(OUTPUT_ONLY)
    }
    create_time {
      number(8)
      field_behavior(OUTPUT_ONLY)
    }
    update_time {
      number(9)
      field_behavior(OUTPUT_ONLY)
    }
    delete_time {
      number(10)
      field_behavior(OUTPUT_ONLY)
    }
    logged_time => number(11)
    quantity {
      number(12)
      field_behavior(OPTIONAL)
    }
    note {
      number(13)
      field_behavior(OPTIONAL)
    }
    observed_generation {
      number(50)
      field_behavior(OUTPUT_ONLY)
    }
    conditions {
      number(51)
      field_behavior(OUTPUT_ONLY)
    }
  }
}
