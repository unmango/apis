package unmango.productivity.focus.v1alpha1

import "../../../../shim/k8s/meta.tdl" as _
import "../../../ref/v1alpha1/ref.tdl" as ref

// A time-boxed block of work, and what actually broke it:
//
//   FocusSession -> Interruption
//
// calendar.event already books time; this is not that. FocusSession is the
// after-the-fact truth about what happened inside a block: planned duration
// against actual, energy before and after, and every point attention
// slipped, tagged by source through its owned Interruptions. That turns
// "I got distracted again" from a vague feeling into a pattern visible over
// time, which time of day, which distraction source, which task, worth
// doing something about.
//
// A FocusSession optionally points at a productivity.task Task through
// task, a plain pointer rather than ownership, the same shape Task uses for
// scheduled_event: several sessions may work the same task, and a session
// with no task at all is still a valid deep-work or body-doubling block.
// ---------------------------------------------------------------------------
// Shared types
// ---------------------------------------------------------------------------
enum FocusTechnique {
  Pomodoro
  Timeboxing
  /// Co-working with another person present, in person or on a call, purely
  /// for the accountability of being watched working.
  BodyDoubling
  DeepWork
  /// Work until natural attention drop-off rather than a fixed interval.
  Flowtime
}

enum FocusSessionState {
  Planned
  InProgress
  Completed
  /// Ended before planned_duration elapsed and without reaching intention.
  Abandoned
}

/// A coarse, always-cheap-to-set self-report, the same treatment
/// journal.entry Mood gives affect. Magnitude rather than valence: energy
/// is not good or bad, only available or not.
enum EnergyLevel { Depleted Low Moderate High }

/// Mirrors Mood's five-point scale.
enum FocusQuality { VeryLow Low Moderate Good VeryGood }

enum InterruptionSource {
  /// An unprompted thought or urge to switch tasks.
  InternalThought
  Notification
  /// Someone else initiated the break in focus.
  Person
  /// Noise, a passing sight, anything ambient rather than addressed to you.
  Environment
  /// Hunger, needing the bathroom, pain, fatigue.
  PhysicalNeed
}

// ---------------------------------------------------------------------------
// FocusSession
// ---------------------------------------------------------------------------
/// One block of work, from intention through what actually happened.
type FocusSession: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  /// The productivity.task Task this session works on. Unset for an
  /// untargeted deep-work or body-doubling block.
  task: ref.ObjectReference
  technique: FocusTechnique
  planned_duration: duration
  planned_start_time: instant
  /// What "done" looks like for this block, decided before starting so
  /// starting does not require also deciding this.
  intention: string
  /// The people.contact Contact co-working this session, for body doubling.
  companion: ref.ObjectReference
  energy_before: EnergyLevel
  // Observed state.
  observed_generation: int
  conditions: [Condition]
  state: FocusSessionState
  start_time: instant
  end_time: instant
  actual_duration: duration
  interruption_count: int32
  energy_after: EnergyLevel
  focus_quality: FocusQuality
}

// ---------------------------------------------------------------------------
// Interruption
// ---------------------------------------------------------------------------
/// One point a FocusSession's attention slipped.
type Interruption: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  /// The FocusSession this interruption happened during.
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  occurred_time: instant
  source: InterruptionSource
  description: string
  /// How long it pulled you away, if you resumed. Unset if it ended the
  /// session instead.
  duration: duration
  // Observed state.
  observed_generation: int
  conditions: [Condition]
}

