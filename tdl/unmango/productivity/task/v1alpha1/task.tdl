package unmango.productivity.task.v1alpha1

import "../../../../shim/google/type.tdl" as gtype
import "../../../../shim/k8s/meta.tdl" as metav1
import "../../../../shim/scalar.tdl" as scalar
import "../../../ref/v1alpha1/ref.tdl" as ref

// Work to be done, with or without a fixed time:
//
//   RecurringTask -> Task -> Task
//
// Tasks nest through owner references rather than a dedicated parent field,
// which is how subtasks stay uniform with every other ownership edge in the
// repository: the same cascade rules and the same List-by-owner query apply.
//
// A Task differs from a calendar.event Event in that it has a deadline rather
// than an interval, and survives being missed.
// ---------------------------------------------------------------------------
// Shared types
// ---------------------------------------------------------------------------
enum TaskState {
  Pending
  InProgress
  /// Waiting on a dependency or on someone else.
  Blocked
  Done
  Cancelled
}

enum TaskPriority { Low Normal High Urgent }
enum RecurrenceFrequency { Daily Weekly Monthly Yearly }

/// Redefined here rather than imported from calendar.event, so the two packages
/// version independently.
type RecurrenceRule {
  frequency: RecurrenceFrequency
  interval: scalar.int32
  by_day: [gtype.DayOfWeek]
  by_month_day: [scalar.int32]
  count: scalar.int32
  until: gtype.Date
  exclude_dates: [gtype.Date]
  /// Schedule the next occurrence relative to when the last one was completed
  /// rather than when it was due. A chore that is done late should not
  /// immediately be due again. Mirrors calendar.event's copy of this field;
  /// keep the two in sync when either changes.
  from_completion: bool
}

// ---------------------------------------------------------------------------
// Task
// ---------------------------------------------------------------------------
/// One thing to be done. Nests to form subtasks.
type Task: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  /// A parent Task for a subtask, or a RecurringTask for a materialized
  /// occurrence.
  owner_refs: [metav1.OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Templated desired state. TaskTemplate mirrors 10-39.
  summary: string
  notes: string
  priority: TaskPriority
  estimated_effort: duration
  /// Tasks that must reach DONE before this one leaves BLOCKED.
  depends_on: [ref.ObjectReference]
  /// The people.contact Contact responsible.
  assignee: ref.ObjectReference
  /// Which subtasks this Task claims.
  selector: metav1.LabelSelector
  /// How far ahead to notify.
  reminders: [duration]
  /// Every subtask must be DONE before this one may be.
  blocked_by_subtasks: bool
  // Assigned desired state. Computed per occurrence for a materialized task.
  due_date: gtype.Date
  /// Time of day the deadline falls. Unset means end of day.
  due_time: gtype.TimeOfDay
  /// Earliest date this should surface. Hides work that cannot start yet.
  defer_until: gtype.Date
  /// The calendar.event Event booked to do this.
  scheduled_event: ref.ObjectReference
  // Observed state.
  observed_generation: int
  state: TaskState
  conditions: [metav1.Condition]
  started_time: instant
  completion_time: instant
  subtask_count: scalar.int32
  completed_subtask_count: scalar.int32
  /// Days past due_date. Negative means not yet due.
  days_overdue: scalar.int32
  /// A dependency has not reached DONE.
  blocked: bool
  actual_effort: duration
}

/// Desired state stamped onto Tasks generated by a RecurringTask. Field numbers
/// mirror Task 10-39; the assigned band is absent because due dates are
/// computed per occurrence.
type TaskTemplate {
  labels: {string -> string}
  annotations: {string -> string}
  summary: string
  notes: string
  priority: TaskPriority
  estimated_effort: duration
  depends_on: [ref.ObjectReference]
  assignee: ref.ObjectReference
  /// Which subtasks a generated Task claims.
  selector: metav1.LabelSelector
  reminders: [duration]
  blocked_by_subtasks: bool
}

// ---------------------------------------------------------------------------
// RecurringTask
// ---------------------------------------------------------------------------
/// A repeating chore, and the owner of every Task it materializes.
type RecurringTask: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [metav1.OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  /// Stamped onto each materialized Task.
  template: TaskTemplate
  rule: RecurrenceRule
  start_date: gtype.Date
  due_time: gtype.TimeOfDay
  /// Surface each occurrence this many days before it is due.
  lead_time_days: scalar.int32
  /// Materialize occurrences up to this date.
  materialize_through: gtype.Date
  /// Which Tasks this chore claims.
  selector: metav1.LabelSelector
  /// Stop materializing without deleting the chore.
  suspended: bool
  /// Keep at most one incomplete occurrence outstanding, rather than letting
  /// missed occurrences pile up. What a daily habit wants.
  skip_missed: bool
  /// Completed occurrences to retain. Zero retains all.
  occurrence_history_limit: scalar.int32
  // Observed state.
  observed_generation: int
  conditions: [metav1.Condition]
  open_occurrence_count: scalar.int32
  completed_occurrence_count: int
  missed_occurrence_count: int
  next_due_date: gtype.Date
  last_completed_date: gtype.Date
  materialized_through: gtype.Date
  /// Completed divided by materialized, over the retained history.
  completion_rate: scalar.double
  /// Consecutive occurrences completed on time.
  current_streak: scalar.int32
}

target protobuf for unmango.productivity.task.v1alpha1 {
  out("gen/tdl")
  edition("2024")
  RecurrenceRule {
