package unmango.pki.certificate.v1alpha1

import "../../../../shim/google/type.tdl" as _
import "../../../../shim/k8s/meta.tdl" as _
import "../../../../shim/rpc.tdl" as _
import "../../../ref/v1alpha1/ref.tdl" as ref

// Standing requests for certificates, and their executions:
//
//   CertificateRequest -> CertificateIssuance @ ci.job JobRun -> Certificate
//   Certificate >> Certificate                          (issuer chain)
//
// A CertificateRequest is the durable definition: these names, from this
// pki.issuer Issuer, with this policy. A CertificateIssuance is one signing
// attempt, owned by the CertificateRequest that materialized it, the same
// split codegen.conversion Conversion draws from ConversionRun and
// iac.stack Stack draws from Run. A Certificate is the immutable,
// content-addressed result: an issuance produces one, or fails.
//
// A CertificateIssuance binds to a ci.job JobRun rather than modelling its
// own execution, the same delegation codegen.conversion ConversionRun and
// iac.stack Run make: ci already models a unit of work, its execution, and
// its placement on capacity. The binding chain runs
// CertificateIssuance -> JobRun -> Runner -> Host, and this domain owns only
// the first hop; an ACME challenge or a Vault sign call is what runs there.
//
// There is no run template, the same reason iac.stack Stack and
// codegen.conversion Conversion have none: a CertificateRequest already
// carries the real specification, so a CertificateIssuance snapshots it at
// creation. That snapshot is what keeps a finished issuance reproducible
// after its CertificateRequest is edited.
//
// Certificate is the third use of the `>>` archetype, alongside
// vcs.commit Commit and codegen.artifact Artifact: a signed certificate is
// immutable once minted, reissuing produces a different one, and
// issuer_fingerprint is fixed at creation because the issuing certificate's
// identity is part of what a conforming chain-of-trust covers. Field bands
// here match those two rather than the mutable kinds:
//   1-9    content-addressed identity
//   10-39  content, fixed at creation and covered by the fingerprint
//   50+    derived, computed by whoever indexes the graph
//
// Private key material is deliberately absent, the same reason commit bytes
// are absent from vcs.commit and generated bytes are absent from
// codegen.artifact: material_uri is a dev.unmango.protofs root, and reading
// or provisioning the actual PEM bytes is an ordinary filesystem operation
// this API does not restate.
// ---------------------------------------------------------------------------
// Shared types
// ---------------------------------------------------------------------------
/// A cryptographic key algorithm. Closed, unlike Platform or an open-string
/// format: an implementer needs an actual branch of code per value, the same
/// reason codegen.converter InvocationKind stays closed.
enum KeyAlgorithm { Rsa Ecdsa Ed25519 }

/// X.509 extended key usage. Closed for the same reason KeyAlgorithm is.
enum CertificateUsage { ServerAuth ClientAuth CodeSigning EmailProtection }

/// Lifecycle of a CertificateIssuance.
enum CertificateIssuancePhase {
  /// Created, no ci.job JobRun bound yet.
  Pending
  Running
  Succeeded
  Failed
  Cancelled
}

// ---------------------------------------------------------------------------
// CertificateRequest
// ---------------------------------------------------------------------------
/// A standing request for a certificate, reissued once its Certificate's
/// remaining lifetime crosses renew_before.
type CertificateRequest: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  /// The pki.issuer Issuer to request from.
  issuer: ref.ObjectReference
  dns_names: [string]
  common_name: string
  ip_addresses: [string]
  key_algorithm: KeyAlgorithm
  /// Bits, meaningful only for KEY_ALGORITHM_RSA.
  key_size: int32
  duration: duration
  /// Reissue once the current Certificate's remaining lifetime falls below
  /// this.
  renew_before: duration
  usages: [CertificateUsage]
  /// The requested certificate can itself sign, the X.509 basic-constraints
  /// CA bit.
  is_ca: bool
  /// A dev.unmango.protofs path the issued material is written to.
  output_uri: string
  // Observed state.
  observed_generation: int
  conditions: [Condition]
  latest_issuance: ref.ObjectReference
  /// Fingerprint of the Certificate the latest successful issuance produced.
  current_certificate_fingerprint: string
  issuance_count: int32
  last_issuance_time: instant
  next_renewal_time: instant
  /// current_certificate_fingerprint has crossed renew_before, or does not yet
  /// exist.
  renewal_due: bool
}

// ---------------------------------------------------------------------------
// CertificateIssuance
// ---------------------------------------------------------------------------
/// One signing attempt for a CertificateRequest.
type CertificateIssuance: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  /// The CertificateRequest that materialized this issuance.
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state, snapshotted from the CertificateRequest at creation so the
  // issuance stays reproducible after the request is edited.
  issuer: ref.ObjectReference
  dns_names: [string]
  common_name: string
  ip_addresses: [string]
  key_algorithm: KeyAlgorithm
  key_size: int32
  duration: duration
  usages: [CertificateUsage]
  is_ca: bool
  output_uri: string
  // Assigned desired state.
  /// The ci.job JobRun executing this issuance. Unset while pending, exactly
  /// as an unscheduled Pod has no node.
  job_run: ref.ObjectReference
  // Observed state.
  observed_generation: int
  phase: CertificateIssuancePhase
  conditions: [Condition]
  start_time: instant
  completion_time: instant
  /// Fingerprint of the Certificate this issuance produced.
  certificate_fingerprint: string
  attempt: int32
  /// Detail on failure: an ACME challenge rejection, a Vault error.
  error_reason: string
}

// ---------------------------------------------------------------------------
// Certificate
// ---------------------------------------------------------------------------
/// One content-addressed, issued X.509 certificate.
///
/// The identity band reserves what an immutable node has no use for,
/// display_name, owner_refs, generation, update_time, and delete_time, rather
/// than compacting around them, so 4 is labels, 5 is annotations, and 8 is
/// create_time here exactly as on every mutable kind.
type Certificate: Entity {
  // Content-addressed identity.
  /// SHA-256 over the DER-encoded certificate: "sha256:...". There is no
  /// separate name, display_name, or owner_refs: nothing declares a
  /// Certificate, so there is nothing to name it or own it.
  fingerprint: string
  uid: uuid
  labels: {string -> string}
  annotations: {string -> string}
  create_time: instant
  // Content, fixed at creation and covered by the fingerprint.
  serial_number: string
  dns_names: [string]
  common_name: string
  ip_addresses: [string]
  key_algorithm: KeyAlgorithm
  usages: [CertificateUsage]
  is_ca: bool
  not_before_time: instant
  not_after_time: instant
  /// The pki.issuer Issuer that minted this.
  issuer: ref.ObjectReference
  /// Fingerprint of the Certificate that signed this one. The `>>` edge,
  /// fixed at creation because the signer's identity is part of what a
  /// conforming chain-of-trust covers. Unset for a self-signed root.
  issuer_fingerprint: string
  /// A dev.unmango.protofs root holding the issued material.
  material_uri: string
  // Derived, computed by whoever indexes the graph.
  conditions: [Condition]
  /// The CertificateIssuances that reached this fingerprint. Repeated and
  /// derived rather than content, the same reason
  /// codegen.artifact Artifact.produced_by is: a retried issuance can reach an
  /// identical certificate only by coincidence of inputs, and which attempt
  /// got there first is not part of the identity.
  issued_by: [ref.ObjectReference]
  revoked: bool
  revoke_time: instant
  revocation_reason: string
  /// not_after_time has passed.
  expired: bool
}

// ---------------------------------------------------------------------------
// CertificateService
// ---------------------------------------------------------------------------
/// Read-only, the same reason vcs.commit CommitService and
/// codegen.artifact ArtifactService are: creating, editing, and deleting are
/// not operations that exist for a content-addressed object.
type CertificateService {
  GetCertificate: Fn<GetCertificateRequest, GetCertificateResponse>
  ListCertificates: Fn<ListCertificatesRequest, ListCertificatesResponse>
  WatchCertificates: Fn<WatchCertificatesRequest, Stream<WatchCertificatesResponse>>
  /// Walk the issuer chain from a leaf toward its root, the trust-graph
  /// equivalent of vcs.commit WalkCommits and codegen.artifact WalkInputs.
  WalkChain: Fn<WalkChainRequest, Stream<WalkChainResponse>>
}

type GetCertificateRequest {
  /// Full or abbreviated fingerprint.
  fingerprint: string
}

type GetCertificateResponse {
  certificate: Certificate
}

type ListCertificatesRequest {
  page_size: int32
  page_token: string
  selector: LabelSelector
  /// Field 4 is `issuer` rather than the `owner` this position holds on every
  /// mutable kind. A certificate has no owner reference to list by; the
  /// issuer is provenance, not ownership.
  issuer: ref.ObjectReference
  dns_names: [string]
  /// Restricts results to certificates whose not_before_time falls within this
  /// window.
  window: Interval
  revoked_only: bool
  expired_only: bool
}

type ListCertificatesResponse {
  certificates: [Certificate]
  next_page_token: string
}

type WatchCertificatesRequest {
  selector: LabelSelector
  issuer: ref.ObjectReference
  /// Resume from this point instead of the current state, so a client that
  /// drops the stream does not have to replay from nothing. Unset starts from
  /// now.
  resource_version: string
}

type WatchCertificatesResponse {
  type: CertificateEventType
  /// Unset on a BOOKMARK event, which carries only the resume point.
  certificate: Certificate
  /// Resume point as of this event. A client stores it and sends it back as
  /// WatchCertificatesRequest.resource_version after a dropped stream, so the
  /// request's resume token has somewhere to come from.
  resource_version: string
}

/// A certificate is never modified, so the event set matches vcs.commit and
/// codegen.artifact. ADDED is a certificate becoming visible; REVOKED is one
/// whose revoked field flipped; DELETED is one purged after expiring.
enum CertificateEventType {
  Added
  Revoked
  Deleted
  /// No change to any certificate. Carries a resource_version so an idle
  /// stream still advances the client's resume point, rather than leaving it
  /// pinned at the last real event. This is the Kubernetes BOOKMARK event.
  Bookmark
}

type WalkChainRequest {
  /// Fingerprint to walk from.
  start_fingerprint: string
}

type WalkChainResponse {
  certificate: Certificate
  /// Edges traversed from start_fingerprint to reach this certificate.
  depth: int32
}

