      number(56)
      field_behavior(OUTPUT_ONLY)
    }
  }
  Run {
    resource("unmango.iac.stack/Run", "runs/{run}", "run", "runs")
    name {
      number(1)
      field_behavior(IDENTIFIER)
    }
    uid {
      number(2)
      field_behavior(OUTPUT_ONLY)
      field_info(UUID4)
    }
    display_name {
      number(3)
      field_behavior(OPTIONAL)
    }
    labels => number(4)
    annotations => number(5)
    owner_refs => number(6)
    generation {
      number(7)
      field_behavior(OUTPUT_ONLY)
    }
    create_time {
      number(8)
      field_behavior(OUTPUT_ONLY)
    }
    update_time {
      number(9)
      field_behavior(OUTPUT_ONLY)
    }
    delete_time {
      number(10)
      field_behavior(OUTPUT_ONLY)
    }
    run_kind => number(11)
    module {
      number(12)
      resource_reference("unmango.iac.module/Module")
    }
    inputs => number(13)
    target_environment {
      number(14)
      field_behavior(OPTIONAL)
    }
    state_uri {
      number(15)
      field_behavior(OPTIONAL)
    }
    timeout => number(16)
    job_run {
      number(40)
      field_behavior(OUTPUT_ONLY)
      resource_reference("unmango.ci.job/JobRun")
    }
    observed_generation {
      number(50)
      field_behavior(OUTPUT_ONLY)
    }
    phase {
      number(51)
