package unmango.compute.host.v1alpha1

import "../../../../shim/k8s/meta.tdl" as _
import "../../../ref/v1alpha1/ref.tdl" as ref
import "../../../uom/v1alpha1/uom.tdl" as uom

// Machines that run work, and the groupings that claim them:
//
//   Cluster => Host
//
// A Host is the capacity provider that ci.runner Runners and
// ci.job JobRuns bind to, the Node of this design. A Cluster claims Hosts
// by label selector rather than naming them, so membership follows labels the
// way a Kubernetes Service follows Pods.
//
// A Host may also carry an asset.maintenance MaintenancePlan, since physical
// machines need servicing on the same terms as vehicles and properties.
// ---------------------------------------------------------------------------
// Shared types
// ---------------------------------------------------------------------------
/// A reachable endpoint for a Host.
type Address {
  type: AddressType
  value: string
}

enum AddressType { Hostname InternalIp ExternalIp WireguardIp }

/// What the machine reports about itself.
type SystemInfo {
  /// "linux", "darwin"
  os: string
  /// "NixOS 25.05"
  os_image: string
  kernel_version: string
  /// "amd64", "arm64"
  architecture: string
  machine_id: string
  container_runtime_version: string
}

/// Repels work that does not explicitly tolerate it.
type Taint {
  key: string
  value: string
  effect: TaintEffect
}

enum TaintEffect {
  /// Refuse to bind new work that does not tolerate this taint.
  NoSchedule
  /// Bind new work only as a last resort.
  PreferNoSchedule
  /// Refuse new work and drain what is already bound.
  NoExecute
}

// ---------------------------------------------------------------------------
// Host
// ---------------------------------------------------------------------------
/// A machine that work is bound to.
type Host: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  hostname: string
  /// The compute.platform Platform this machine physically runs on or
  /// was provisioned from.
  provider: ref.ObjectReference
  /// Cordon. Existing work keeps running, nothing new binds.
  unschedulable: bool
  taints: [Taint]
  /// Capacity held back for the operating system, subtracted from observed
  /// capacity to yield allocatable.
  reserved: uom.ResourceQuantity
  /// The asset.property Space this machine physically sits in.
  location: ref.ObjectReference
  // Observed state.
  observed_generation: int
  phase: HostPhase
  conditions: [Condition]
  addresses: [Address]
  system_info: SystemInfo
  /// Total compute the machine reports.
  capacity: uom.ResourceQuantity
  /// Capacity minus reserved. What work can actually be bound against.
  allocatable: uom.ResourceQuantity
  /// Sum of the requests of everything currently bound here.
  allocated: uom.ResourceQuantity
  boot_time: instant
  last_heartbeat_time: instant
}

enum HostPhase {
  /// Registered but not yet reporting.
  Pending
  /// Healthy and accepting work.
  Ready
  /// Reporting, but failing a health condition.
  NotReady
  /// Deliberately drained for servicing.
  Maintenance
  /// Heartbeat lost.
  Unreachable
}

// ---------------------------------------------------------------------------
// Cluster
// ---------------------------------------------------------------------------
/// A named set of Hosts, claimed by label selector rather than by name. Adding
/// a matching label to a Host joins it; no edit to the Cluster is needed.
type Cluster: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  /// Which Hosts belong. An empty selector claims nothing, never everything.
  selector: LabelSelector
  /// Applied to every member, so a whole cluster can be drained at once.
  unschedulable: bool
  // Observed state.
  observed_generation: int
  member_count: int32
  ready_member_count: int32
  /// Summed across members.
  capacity: uom.ResourceQuantity
  allocatable: uom.ResourceQuantity
  allocated: uom.ResourceQuantity
  conditions: [Condition]
}

