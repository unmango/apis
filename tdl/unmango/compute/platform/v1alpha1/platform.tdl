package unmango.compute.platform.v1alpha1

import "../../../../shim/k8s/meta.tdl" as _

// External systems and tools other resources integrate with:
//
//   Platform
//
// Platform is the kind the rest of the repository points at whenever a
// resource names an external system rather than declaring facts about one
// inline: a vcs.repository Repository's forge and version control system, a
// ci.runner Runner's CI system, a compute.host Host's hosting provider, a
// codegen.converter Converter's underlying tool.
// Kept alongside compute.host Host rather than in a domain of its own: both
// are infrastructure other domains bind to or point at without owning, the
// same role compute.host Host already plays for ci.runner and vcs.repository.
//
// One Platform per distinct product, not per vendor: a vendor offering more
// than one surface, GitHub the forge and GitHub Actions the CI system, gets
// a Platform for each, since a Repository's forge and a Runner's CI system
// are different attachment points even when the same company operates both.
//
// Kept as a referenced resource rather than a closed enum on every domain
// that needs one: an enum bakes a fixed vendor list into the schema itself,
// can't express a self-hosted or niche system, and repeats every entry in
// each domain that names it. A Platform is data, created once and pointed
// at by ObjectReference from anywhere in the graph.
// ---------------------------------------------------------------------------
// Shared types
// ---------------------------------------------------------------------------
/// What role a Platform plays for whoever references it.
enum PlatformKind {
  Forge
  Ci
  HostingProvider
  VersionControlSystem
  /// A tool a codegen.converter Converter wraps: Buf, tree-sitter, Upjet.
  CodegenTool
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------
/// An external system or tool that other resources point at by reference.
type Platform: Entity {
  name: string
  uid: uuid
  display_name: string
  labels: {string -> string}
  annotations: {string -> string}
  owner_refs: [OwnerReference]
  generation: int
  create_time: instant
  /// Last write, server-stamped.
  update_time: instant
  delete_time: instant
  // Desired state.
  kind: PlatformKind
  website: string
  // Observed state.
  observed_generation: int
  conditions: [Condition]
}

target protobuf for unmango.compute.platform.v1alpha1 {
  out("../../../../../proto")
  file("platform.proto")
  import("google/api/field_behavior.proto")
  import("google/api/field_info.proto")
  import("google/api/resource.proto")
  Condition => foreign("k8s.io/apimachinery/pkg/apis/meta/v1/generated.proto", "k8s.io.apimachinery.pkg.apis.meta.v1.Condition")
  OwnerReference => foreign("k8s.io/apimachinery/pkg/apis/meta/v1/generated.proto", "k8s.io.apimachinery.pkg.apis.meta.v1.OwnerReference")
  edition("2024")
  Platform {
    option("(google.api.resource)", "{ type: \"unmango.compute.platform/Platform\" pattern: \"platforms/{platform}\" singular: \"platform\" plural: \"platforms\" }")
    name {
      number(1)
      option("(google.api.field_behavior)", "IDENTIFIER")
    }
    uid {
      number(2)
      option("(google.api.field_behavior)", "OUTPUT_ONLY")
      option("(google.api.field_info).format", "UUID4")
    }
    display_name {
      number(3)
      option("(google.api.field_behavior)", "OPTIONAL")
    }
    labels => number(4)
    annotations => number(5)
    owner_refs => number(6)
    generation {
      number(7)
      option("(google.api.field_behavior)", "OUTPUT_ONLY")
    }
    create_time {
      number(8)
      option("(google.api.field_behavior)", "OUTPUT_ONLY")
    }
    update_time {
      number(9)
      option("(google.api.field_behavior)", "OUTPUT_ONLY")
    }
    delete_time {
      number(10)
      option("(google.api.field_behavior)", "OUTPUT_ONLY")
    }
    kind => number(11)
    website {
      number(12)
      option("(google.api.field_behavior)", "OPTIONAL")
    }
    observed_generation {
      number(50)
      option("(google.api.field_behavior)", "OUTPUT_ONLY")
    }
    conditions {
      number(51)
      option("(google.api.field_behavior)", "OUTPUT_ONLY")
    }
  }
}
